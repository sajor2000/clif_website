---
import { PROJECT_RUN_VERSIONS, runnableTableGroups } from '../../data/clif-tables';

// Checklist of the CLIF tables a project run needs sites to have. One set of
// checkboxes is rendered per version; the page script shows only the set for
// the form's selected CLIF version and submits only its checked tables.
//
// Each maturity group (Beta / Alpha / Concept) is collapsible. Its header keeps
// a live "N selected" count so picks stay visible while it is collapsed.
interface Props {
  /** CLIF version whose tables start visible; none shows a prompt instead. */
  current?: string | null;
  /** Tables to pre-check (when editing an existing run). */
  selected?: string[];
}

const { current = null, selected = [] } = Astro.props;
---

<div class="tables-picker-root">
  <p class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
    Tables sites need to have <span class="text-red-500">*</span>
  </p>
  <p class="text-xs text-gray-400 dark:text-gray-500 mb-2">Check every CLIF table a site must have to run this project.</p>
  <p class={`tables-picker-empty text-xs italic text-gray-400 dark:text-gray-500 ${current ? 'hidden' : ''}`}>
    Select a CLIF version to see its tables.
  </p>
  {PROJECT_RUN_VERSIONS.map((v) => {
    const groups = runnableTableGroups(v).map((g) => ({
      ...g,
      picked: v === current ? g.tables.filter((t) => selected.includes(t)) : [],
    }));
    const anyPicked = groups.some((g) => g.picked.length > 0);
    return (
      <div class={`tables-picker space-y-2 ${v === current ? '' : 'hidden'}`} data-version={v}>
        {groups.map((g) => (
          // Open the groups holding existing picks; on a fresh form, just Beta.
          <details
            class="tables-group group/tg rounded-lg border border-gray-200 dark:border-neutral-700"
            open={anyPicked ? g.picked.length > 0 : g.label === 'Beta'}
          >
            <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-neutral-700/30">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 shrink-0 text-gray-400 dark:text-gray-500 transition-transform group-open/tg:rotate-90" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">{g.label}</span>
              <span class="text-[11px] text-gray-400 dark:text-gray-500">{g.tables.length} tables</span>
              <span class="tables-group-count ml-auto text-[11px] font-medium text-clif-burgundy">
                {g.picked.length > 0 ? `${g.picked.length} selected` : ''}
              </span>
            </summary>
            <div class="px-3 pb-3">
              <div class="flex items-center gap-2 mb-1.5">
                <button type="button" class="tables-group-all text-[11px] text-clif-burgundy hover:underline">Select all</button>
                <span class="text-[11px] text-gray-300 dark:text-gray-600" aria-hidden="true">·</span>
                <button type="button" class="tables-group-none text-[11px] text-clif-burgundy hover:underline">Clear</button>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-1">
                {g.tables.map((t) => (
                  <label class="flex items-center gap-2 text-xs text-gray-700 dark:text-gray-300 cursor-pointer min-w-0">
                    <input
                      type="checkbox"
                      autocomplete="off"
                      class="table-cb w-3.5 h-3.5 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy"
                      value={t}
                      checked={g.picked.includes(t)}
                    />
                    <span class="font-mono truncate">{t}</span>
                  </label>
                ))}
              </div>
            </div>
          </details>
        ))}
      </div>
    );
  })}
</div>
