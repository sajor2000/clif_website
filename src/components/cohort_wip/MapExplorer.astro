---
// CLIF Map Explorer - Interactive map showing consortium sites
import { readFile } from 'fs/promises';
import { join } from 'path';
import { countsForCohort, COHORTS, SUBCOHORTS, DEFAULT_COHORT, type SiteCounts } from '../../utils/cohortData';

// Read and parse the CSV file at build time
const csvPath = join(process.cwd(), 'src', 'data', 'site_details.csv');
const csvContent = await readFile(csvPath, 'utf-8');
const lines = csvContent.trim().split('\n');

// Per-site counts come from countsForCohort() in cohortData.ts (shared with
// Summary Statistics). Geography/lat-long still come from site_details.csv.

const cohortSiteCounts: Record<string, Record<string, SiteCounts>> = {};
for (const c of COHORTS) cohortSiteCounts[c.key] = countsForCohort(c.key);
for (const s of SUBCOHORTS) cohortSiteCounts[s.key] = countsForCohort(s.key);

// SSR still renders the default cohort so the markup is never empty.
const freshCounts = cohortSiteCounts[DEFAULT_COHORT] || {};

// Parse CSV helper function
function parseCSVLine(line: string): string[] {
  const result: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];
    if (char === '"') {
      inQuotes = !inQuotes;
    } else if (char === ',' && !inQuotes) {
      result.push(current);
      current = '';
    } else {
      current += char;
    }
  }
  result.push(current);
  return result;
}

// Parse site data
interface SiteData {
  name: string;
  location: string;
  latitude: number;
  longitude: number;
  dataReady: boolean;
  hospitals: number;
  encounters: number;
  patients: number;
}

const sites: SiteData[] = [];
for (let i = 1; i < lines.length; i++) {
  const values = parseCSVLine(lines[i]);
  if (values.length >= 8) {
    // Replace Unicode minus sign (U+2212) with regular hyphen-minus
    const latStr = values[2].trim().replace(/−/g, '-');
    const lonStr = values[3].trim().replace(/−/g, '-');

    const name = values[0].trim();
    const fresh = freshCounts[name];
    const site: SiteData = {
      name,
      location: values[1].trim(),
      latitude: parseFloat(latStr),
      longitude: parseFloat(lonStr),
      dataReady: values[4].trim().toLowerCase() === 'yes',
      hospitals: fresh ? fresh.hospitals : (values[5].trim() ? parseInt(values[5].trim().replace(/,/g, '')) : 0),
      encounters: fresh ? fresh.encounters : (values[6].trim() ? parseInt(values[6].trim().replace(/,/g, '')) : 0),
      patients: fresh ? fresh.patients : (values[7].trim() ? parseInt(values[7].trim().replace(/,/g, '')) : 0),
    };
    sites.push(site);
  }
}

// Serialize sites data for client-side use
const sitesJSON = JSON.stringify(sites);
const cohortCountsJSON = JSON.stringify(cohortSiteCounts);
const defaultCohortKey = DEFAULT_COHORT;
---

<div class="map-explorer">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-3">CLIF Consortium Map</h2>
    <p class="text-lg text-gray-600">Explore participating institutions across North America</p>
  </div>

  <!-- Map Container with Embedded Legend and Stats -->
  <div class="relative rounded-xl shadow-lg mb-8">
    <div id="map" class="rounded-xl" style="height: 600px;"></div>

    <!-- Legend - Embedded in bottom left -->
    <div class="absolute bottom-8 left-6 bg-white/95 backdrop-blur-sm px-4 py-3 rounded-lg shadow-lg z-[1000]">
      {/* Three states — see markerHtml(). "Active, no data in this cohort" is
          NOT the same as "upcoming", and greying both alike misstated it. */}
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-clif-burgundy rounded-full border border-white shadow-sm"></div>
          <span class="text-xs font-medium text-gray-700">In this cohort</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-white border-2 border-clif-burgundy shadow-sm"></div>
          <span class="text-xs font-medium text-gray-700">Active site, not in this cohort</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-gray-400 rounded-full border border-white shadow-sm"></div>
          <span class="text-xs font-medium text-gray-700">Upcoming site</span>
        </div>
      </div>
    </div>

    <!-- Stats Panel - Embedded in top right -->
    <div class="absolute top-6 right-6 bg-white/95 backdrop-blur-sm rounded-lg shadow-lg z-[1000] overflow-hidden">
      <div class="flex flex-col divide-y divide-gray-100">
        <!-- Total Institutions -->
        <div class="px-2.5 py-1.5 hover:bg-gray-50 transition-colors">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-clif-burgundy" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
            </svg>
            <div id="map-stat-institutions" class="text-lg font-bold text-clif-burgundy">{sites.length}</div>
          </div>
          <div class="text-[9px] text-gray-600 font-medium uppercase tracking-wide">Institutions</div>
        </div>

        <!-- Active Sites -->
        <div class="px-2.5 py-1.5 hover:bg-gray-50 transition-colors">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-clif-burgundy" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <div id="map-stat-active" class="text-lg font-bold text-clif-burgundy">{Object.keys(freshCounts).length}</div>
          </div>
          {/* Not "Active Sites": that is a fixed property of a site (12 of the
              15 institutions are active) and does not vary by cohort. This
              counts the sites contributing data to the SELECTED cohort. */}
          <div class="text-[9px] text-gray-600 font-medium uppercase tracking-wide">Sites in Cohort</div>
        </div>

        <!-- Total Hospitals -->
        <div class="px-2.5 py-1.5 hover:bg-gray-50 transition-colors">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-clif-burgundy" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 6a3 3 0 013-3h10a1 1 0 01.8 1.6L14.25 8l2.55 3.4A1 1 0 0116 13H6a1 1 0 00-1 1v3a1 1 0 11-2 0V6z" clip-rule="evenodd"/>
            </svg>
            <div id="map-stat-hospitals" class="text-lg font-bold text-clif-burgundy">{sites.reduce((sum, s) => sum + s.hospitals, 0)}</div>
          </div>
          <div class="text-[9px] text-gray-600 font-medium uppercase tracking-wide">Hospitals</div>
        </div>

        <!-- Total Patients -->
        <div class="px-2.5 py-1.5 hover:bg-gray-50 transition-colors">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-clif-burgundy" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
            <div id="map-stat-patients" class="text-lg font-bold text-clif-burgundy">{sites.reduce((sum, s) => sum + s.patients, 0).toLocaleString()}</div>
          </div>
          <div class="text-[9px] text-gray-600 font-medium uppercase tracking-wide">Patients</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .map-explorer {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  #map {
    z-index: 1;
  }

  /* Leaflet popup custom styling */
  :global(.leaflet-popup-content-wrapper) {
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  :global(.leaflet-popup-content) {
    margin: 16px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  :global(.site-popup h4) {
    font-size: 18px;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 8px;
  }

  :global(.site-popup .location) {
    color: #6b7280;
    font-size: 14px;
    margin-bottom: 12px;
  }

  :global(.site-popup .stats) {
    display: grid;
    gap: 8px;
    font-size: 14px;
  }

  :global(.site-popup .stat-row) {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    border-bottom: 1px solid #e5e7eb;
  }

  :global(.site-popup .stat-row:last-child) {
    border-bottom: none;
  }

  :global(.site-popup .stat-label) {
    color: #6b7280;
    font-weight: 500;
  }

  :global(.site-popup .stat-value) {
    color: #1f2937;
    font-weight: 600;
  }

  :global(.site-popup .status-badge) {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
    margin-top: 8px;
  }

  :global(.site-popup .status-active) {
    background-color: #d1fae5;
    color: #065f46;
  }

  :global(.site-popup .status-upcoming) {
    background-color: #e5e7eb;
    color: #374151;
  }

  /* An active site with nothing in the selected cohort. Distinct from "Coming
     Soon" — the site contributes, just not to this cohort. */
  :global(.site-popup .no-cohort-data) {
    color: #6b7280;
    font-size: 13px;
    font-style: italic;
    padding: 8px 0;
  }
</style>

<script define:vars={{ sitesJSON, cohortCountsJSON, defaultCohortKey }}>
  // Parse sites data
  const sites = JSON.parse(sitesJSON);

  // Per-cohort per-site counts; geography above is cohort-independent.
  const COHORT_COUNTS = JSON.parse(cohortCountsJSON);
  let activeCohort = defaultCohortKey;

  // Store map instance globally
  let mapInstance = null;
  // Markers are kept by site name so a cohort change repaints in place rather
  // than tearing down and rebuilding the map (which would drop the viewport).
  const markersByName = {};

  /** Counts for a site in the active cohort, or null when it has none. */
  function countsFor(siteName) {
    const forCohort = COHORT_COUNTS[activeCohort] || {};
    return forCohort[siteName] || null;
  }

  function popupHtml(site) {
    const counts = countsFor(site.name);
    let html = `
        <div class="site-popup">
          <h4>${site.name}</h4>
          <div class="location">${site.location}</div>
    `;
    if (site.dataReady && counts) {
      html += `
          <div class="stats">
            <div class="stat-row">
              <span class="stat-label">Hospitals:</span>
              <span class="stat-value">${counts.hospitals.toLocaleString()}</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Patients:</span>
              <span class="stat-value">${counts.patients.toLocaleString()}</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Hospitalizations:</span>
              <span class="stat-value">${counts.encounters.toLocaleString()}</span>
            </div>
          </div>
          <div class="status-badge status-active">Active</div>
      `;
    } else if (site.dataReady) {
      // Active site with nothing in THIS cohort — say so rather than showing
      // another cohort's numbers or a misleading zero.
      html += `<div class="no-cohort-data">No data in this cohort</div>
               <div class="status-badge status-upcoming">Active site</div>`;
    } else {
      html += `<div class="status-badge status-upcoming">Coming Soon</div>`;
    }
    return html + `</div>`;
  }

  /**
   * Three states, because "contributes to this cohort" and "is an active CLIF
   * site" are different facts. A site can be active and still have no data in
   * the selected cohort — painting it the same grey as an upcoming site said
   * something false about its membership.
   *   solid burgundy  — contributes to the selected cohort
   *   hollow burgundy — active site, no data in this cohort
   *   solid grey      — upcoming, not yet contributing anywhere
   */
  function markerHtml(site) {
    const base = 'width: 24px; height: 24px; border-radius: 50%; box-shadow: 0 2px 8px rgba(0,0,0,0.3);';
    if (site.dataReady && countsFor(site.name)) {
      return `<div style="${base} background-color: #8B1538; border: 3px solid white;"></div>`;
    }
    if (site.dataReady) {
      return `<div style="${base} background-color: white; border: 3px solid #8B1538; opacity: 0.85;"></div>`;
    }
    return `<div style="${base} background-color: #9ca3af; border: 3px solid white; opacity: 0.55;"></div>`;
  }

  /** Repaint every marker, its popup, and the corner totals for activeCohort. */
  function paintCohort() {
    const forCohort = COHORT_COUNTS[activeCohort] || {};
    sites.forEach((site) => {
      const marker = markersByName[site.name];
      if (!marker) return;
      marker.setIcon(L.divIcon({
        className: 'custom-marker',
        html: markerHtml(site),
        iconSize: [24, 24],
        iconAnchor: [12, 12],
      }));
      marker.setPopupContent(popupHtml(site));
    });

    const contributing = sites.filter((s) => forCohort[s.name]);
    const set = (id, value) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    // Institutions stays the roster size — it is not cohort-dependent. The
    // other three describe the selected cohort.
    set('map-stat-active', String(contributing.length));
    set('map-stat-hospitals', String(contributing.reduce((sum, s) => sum + forCohort[s.name].hospitals, 0)));
    set('map-stat-patients', contributing.reduce((sum, s) => sum + forCohort[s.name].patients, 0).toLocaleString());
  }

  // Initialize map function
  function initializeMap() {
    // Check if Leaflet is loaded
    if (typeof L === 'undefined') {
      console.error('Leaflet library not loaded');
      return;
    }

    const mapElement = document.getElementById('map');
    if (!mapElement) {
      console.error('Map element not found');
      return;
    }

    // Remove existing map if it exists
    if (mapInstance) {
      mapInstance.remove();
    }

    // Add OpenStreetMap tile layer first
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 18,
    });

    // Initialize map centered between USA and Toronto with appropriate zoom
    // Center point roughly at 42°N, 95°W (shifted slightly west and north)
    // Zoom level 4.5 shows USA coast-to-coast including western sites
    mapInstance = L.map('map', {
      center: [42, -98],
      zoom: 4.5,
      minZoom: 4,
      maxZoom: 18,
      preferCanvas: false,
    });

    // Add tile layer to the map
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 18,
    }).addTo(mapInstance);

    // Set max bounds to prevent excessive panning away from North America
    const maxBounds = L.latLngBounds(
      L.latLng(20, -400),  // Southwest (extended west)
      L.latLng(55, -60)    // Northeast
    );
    mapInstance.setMaxBounds(maxBounds);

    // Add markers for each site. Content comes from the paint helpers so the
    // first render and every cohort change go through identical code.
    sites.forEach(site => {
      const marker = L.marker([site.latitude, site.longitude], {
        icon: L.divIcon({
          className: 'custom-marker',
          html: markerHtml(site),
          iconSize: [24, 24],
          iconAnchor: [12, 12],
        }),
      })
        .addTo(mapInstance)
        .bindPopup(popupHtml(site));
      markersByName[site.name] = marker;
    });

    paintCohort();

    // Force map to refresh its size
    setTimeout(() => {
      mapInstance.invalidateSize();
    }, 100);
  }

  // Initialize map when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    // Delay initialization to ensure the tab content is ready
    setTimeout(initializeMap, 300);

    // Follow the cohort picker. Sub-cohorts (advanced_resp__icu, ...) have
    // their own counts; anything unknown falls back to its parent so the map
    // never silently keeps another cohort's numbers.
    if (window.CohortBus && typeof window.CohortBus.subscribe === 'function') {
      window.CohortBus.subscribe((key) => {
        const effective = COHORT_COUNTS[key] ? key : String(key).split('__')[0];
        if (!COHORT_COUNTS[effective] || effective === activeCohort) return;
        activeCohort = effective;
        if (mapInstance) paintCohort();
      });
    }
  });

  // Re-initialize map when Map Explorer tab becomes visible
  // Listen for custom event or mutation observer
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        const mapContent = document.getElementById('content-map');
        if (mapContent && !mapContent.classList.contains('hidden')) {
          setTimeout(() => {
            if (mapInstance) {
              mapInstance.invalidateSize();
            } else {
              initializeMap();
            }
          }, 100);
        }
      }
    });
  });

  // Observe the map content div for visibility changes
  setTimeout(() => {
    const mapContent = document.getElementById('content-map');
    if (mapContent) {
      observer.observe(mapContent, { attributes: true });
    }
  }, 500);
</script>
