---
/**
 * Info affordance explaining how a number was computed.
 *
 * Two ways to use it:
 *   <InfoTip characteristic="ICU episodes, total n" />   look the definition up
 *   <InfoTip text="..." source="..." />                  supply one directly,
 *                                                        for tiles that are
 *                                                        derived rather than a
 *                                                        CSV row
 *
 * Renders nothing when there is no definition, so it can be dropped beside any
 * value without guarding each call site.
 *
 * The icon inherits `currentColor`, so it works on the white cards and on the
 * burgundy tiles without a variant.
 */
import { definitionFor } from '../../utils/characteristicDefinitions';

interface Props {
  characteristic?: string;
  text?: string;
  source?: string;
}

const { characteristic, text, source } = Astro.props;
const def = characteristic
  ? definitionFor(characteristic)
  : text
    ? { text, source: source ?? '' }
    : null;
---

{def && (
  <span
    class="info-tip"
    tabindex="0"
    role="note"
    aria-label={`Definition: ${def.text}`}
  >
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
    </svg>
    <span class="info-tip-card">{def.text}</span>
  </span>
)}

<style>
  .info-tip {
    position: relative;
    display: inline-flex;
    margin-left: 0.25rem;
    vertical-align: text-top;
    opacity: 0.5;
    cursor: help;
  }

  .info-tip svg {
    width: 0.8em;
    height: 0.8em;
  }

  .info-tip:hover,
  .info-tip:focus {
    opacity: 1;
    outline: none;
  }

  /* position: fixed, NOT absolute.
     Several of these tiles set overflow-hidden to clip their watermark icon,
     and an absolutely-positioned card is clipped along with it — the tooltip
     was being cut off mid-sentence. A fixed card escapes an overflow-hidden
     ancestor (none of these tiles create a containing block via transform), so
     it can render over the card edge. The trade-off is that fixed coordinates
     are viewport-relative, so the script below places it on hover. */
  .info-tip-card {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    display: none;
    width: 19rem;
    max-width: 70vw;
    padding: 0.6rem 0.7rem;
    border-radius: 0.5rem;
    background: #1f2937;
    color: #f9fafb;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: left;
    white-space: normal;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .info-tip:hover .info-tip-card,
  .info-tip:focus .info-tip-card {
    display: block;
  }
</style>

<script>
  // Places the fixed-position card next to its icon. Astro hoists and dedupes
  // component scripts, so this runs once no matter how many tips are on the
  // page, and uses delegation rather than a listener per instance.
  //
  // Beyond escaping overflow-hidden tiles, doing this in JS also lets the card
  // pick a side: it prefers below-and-left-aligned, flips above when there is
  // no room below, and clamps to the viewport so a tip near the right edge
  // stays fully readable. The `align` prop is no longer needed for that.
  function placeInfoTip(tip: Element) {
    const card = tip.querySelector<HTMLElement>('.info-tip-card');
    if (!card) return;
    const icon = tip.getBoundingClientRect();
    const gap = 8;
    const margin = 8;

    // Measure at its natural size before deciding a side.
    card.style.visibility = 'hidden';
    card.style.display = 'block';
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    card.style.display = '';
    card.style.visibility = '';

    const below = icon.bottom + gap;
    const top = below + h > window.innerHeight - margin && icon.top - gap - h > margin
      ? icon.top - gap - h
      : below;

    let left = icon.left;
    if (left + w > window.innerWidth - margin) left = window.innerWidth - margin - w;
    if (left < margin) left = margin;

    card.style.top = `${Math.round(top)}px`;
    card.style.left = `${Math.round(left)}px`;
  }

  for (const evt of ['mouseenter', 'focusin'] as const) {
    document.addEventListener(
      evt,
      (e) => {
        const tip = (e.target as HTMLElement | null)?.closest?.('.info-tip');
        if (tip) placeInfoTip(tip);
      },
      true, // capture: mouseenter does not bubble
    );
  }
</script>
