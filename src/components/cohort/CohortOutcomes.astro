---
// Cohort "Outcomes" panel — severity/outcome charts from the _aggregated export.
// One instance per cohort; visibility toggled by window.CohortBus (render-per-cohort,
// same pattern as CohortSummaryFromCSV). Charts a cohort has no data for are omitted.
import fs from 'node:fs';
import path from 'node:path';
import { DEFAULT_COHORT } from '../../utils/cohortData';
import { parseCSVLine } from '../../utils/csvLine';

interface Props {
  cohort?: string;
}
const { cohort = DEFAULT_COHORT } = Astro.props;
const uid = cohort;
const isDefault = cohort === DEFAULT_COHORT;
const dir = path.join(process.cwd(), 'src', 'data', 'cohorts', cohort);

// Parse a wide `<category>, <metric>__<Site>` file, keeping the __ALL aggregate.
function parseWide(file: string): Array<Record<string, string>> {
  const p = path.join(dir, file);
  if (!fs.existsSync(p)) return [];
  const lines = fs.readFileSync(p, 'utf-8').trim().split('\n');
  const headers = parseCSVLine(lines[0]);
  const allCols: Record<string, number> = {};
  headers.forEach((h, i) => {
    const m = h.trim().match(/^(.+)__ALL$/);
    if (m) allCols[m[1]] = i;
  });
  const rows: Array<Record<string, string>> = [];
  for (let i = 1; i < lines.length; i++) {
    const v = parseCSVLine(lines[i]);
    const cat = (v[0] ?? '').trim();
    if (!cat) continue;
    const rec: Record<string, string> = { _cat: cat };
    for (const [metric, idx] of Object.entries(allCols)) rec[metric] = (v[idx] ?? '').trim();
    rows.push(rec);
  }
  return rows;
}
const num = (s: string | undefined) => {
  const n = parseFloat((s ?? '').replace(/,/g, ''));
  return Number.isFinite(n) ? n : null;
};

// SOFA -> mortality dose-response (with 95% CI band).
const sofaRows = parseWide('sofa_mortality_summary.csv');
const sofa = sofaRows
  .map((r) => ({
    score: num(r._cat),
    mortality: num(r.mortality_rate_percent),
    lo: num(r.ci_lower_95),
    hi: num(r.ci_upper_95),
    n: num(r.n_encounters),
    deaths: num(r.n_deaths),
  }))
  .filter((r) => r.score !== null && r.mortality !== null)
  .sort((a, b) => (a.score! - b.score!));

// Comorbidities per 1,000 hospitalizations (ranked).
const comorbRows = parseWide('comorbidities_per_1000_hospitalizations.csv');
function titleCase(s: string) {
  return s.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
const comorb = comorbRows
  .map((r) => ({
    name: titleCase(r._cat),
    per1000: num(r.per_1000_hospitalizations),
    pct: num(r.prevalence_percent),
  }))
  .filter((r) => r.per1000 !== null)
  .sort((a, b) => (b.per1000! - a.per1000!));

// Code status distribution (encounter_type x code_status, % of encounter type).
function parseCodeStatus() {
  const p = path.join(dir, 'code_status_combined_summary.csv');
  if (!fs.existsSync(p)) return null;
  const lines = fs.readFileSync(p, 'utf-8').trim().split('\n');
  const headers = parseCSVLine(lines[0]);
  const pctIdx = headers.findIndex((h) => h.trim() === 'percentage__ALL');
  if (pctIdx === -1) return null;
  const map: Record<string, Record<string, number>> = {};
  const statuses: string[] = [];
  for (let i = 1; i < lines.length; i++) {
    const v = parseCSVLine(lines[i]);
    const et = (v[0] ?? '').trim();
    const cs = (v[1] ?? '').trim();
    const pct = num(v[pctIdx]);
    if (!et || !cs || pct === null) continue;
    (map[et] ||= {})[cs] = pct;
    if (!statuses.includes(cs)) statuses.push(cs);
  }
  const encounterTypes = Object.keys(map);
  if (!encounterTypes.length) return null;
  return { encounterTypes, statuses, map };
}
const codeStatus = parseCodeStatus();

// STROBE cohort-flow counts (ordered by the numeric prefix in count_name).
const strobe = parseWide('strobe_counts.csv')
  .map((r) => ({ raw: r._cat, value: num(r.count_value) }))
  .filter((r) => r.value !== null)
  .sort((a, b) => (parseInt(a.raw) || 0) - (parseInt(b.raw) || 0))
  .map((r) => ({ label: titleCase(r.raw.replace(/^\d+_/, '')), value: r.value }));

// UpSet-style overlap of critical-care criteria (top combinations by n).
function parseUpset() {
  const p = path.join(dir, 'upset_data.csv');
  if (!fs.existsSync(p)) return [];
  const lines = fs.readFileSync(p, 'utf-8').trim().split('\n');
  const headers = parseCSVLine(lines[0]);
  const nIdx = headers.findIndex((h) => h.trim() === 'n__ALL');
  const crit = ['ICU Hospitalizations', 'Died', 'Advanced O2 Support', 'Vasoactive Support'];
  const shortName: Record<string, string> = { 'ICU Hospitalizations': 'ICU', Died: 'Died', 'Advanced O2 Support': 'Adv O2', 'Vasoactive Support': 'Vasopressor' };
  const idx = crit.map((c) => headers.findIndex((h) => h.trim() === c));
  const combos: Array<{ label: string; n: number }> = [];
  for (let i = 1; i < lines.length; i++) {
    const v = parseCSVLine(lines[i]);
    const n = num(v[nIdx]);
    if (n === null) continue;
    const active = crit.filter((_, j) => (v[idx[j]] ?? '').trim().toLowerCase() === 'true').map((c) => shortName[c]);
    combos.push({ label: active.length ? active.join(' + ') : 'None of the four', n });
  }
  return combos.sort((a, b) => b.n - a.n);
}
const upset = parseUpset();

const hasSofa = sofa.length > 0;
const hasComorb = comorb.length > 0;
const hasCodeStatus = !!codeStatus;
const hasStrobe = strobe.length > 0;
const hasUpset = upset.length > 0;
const payload = JSON.stringify({ sofa, comorb, codeStatus, strobe, upset });
---

<div class={`cohort-outcomes-panel${isDefault ? '' : ' hidden'}`} id={`outcomes-${uid}`} data-cohort={uid}>
  {!hasSofa && !hasComorb && (
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center text-gray-500">
      No outcome data available for this cohort.
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {hasSofa && (
      <div class="bg-white p-5 rounded-lg shadow border border-gray-200">
        <h3 class="text-base font-semibold mb-1 text-gray-800">Mortality by SOFA Score</h3>
        <p class="text-xs text-gray-500 mb-3">In-hospital mortality (%) by admission SOFA score, with 95% CI. Consortium aggregate.</p>
        <div style="height: 300px;"><canvas id={`sofa-chart-${uid}`}></canvas></div>
      </div>
    )}

    {hasComorb && (
      <div class="bg-white p-5 rounded-lg shadow border border-gray-200">
        <h3 class="text-base font-semibold mb-1 text-gray-800">Comorbidities per 1,000 Hospitalizations</h3>
        <p class="text-xs text-gray-500 mb-3">Charlson comorbidity prevalence per 1,000. Consortium aggregate.</p>
        <div style="height: 300px; overflow-y: auto;"><canvas id={`comorb-chart-${uid}`} height="380"></canvas></div>
      </div>
    )}

    {hasCodeStatus && (
      <div class="bg-white p-5 rounded-lg shadow border border-gray-200">
        <h3 class="text-base font-semibold mb-1 text-gray-800">Code Status by Encounter Type</h3>
        <p class="text-xs text-gray-500 mb-3">Distribution of documented code status (% within each encounter type).</p>
        <div style="height: 320px;"><canvas id={`codestatus-chart-${uid}`}></canvas></div>
      </div>
    )}

    {hasUpset && (
      <div class="bg-white p-5 rounded-lg shadow border border-gray-200">
        <h3 class="text-base font-semibold mb-1 text-gray-800">Critical-Care Criteria Overlap</h3>
        <p class="text-xs text-gray-500 mb-3">Hospitalizations by combination of ICU / Died / Advanced O2 / Vasopressor.</p>
        <div style="height: 320px; overflow-y: auto;"><canvas id={`upset-chart-${uid}`} height="380"></canvas></div>
      </div>
    )}
  </div>

  {hasStrobe && (
    <div class="bg-white p-5 rounded-lg shadow border border-gray-200 mt-6">
      <h3 class="text-base font-semibold mb-1 text-gray-800">Cohort Construction (STROBE)</h3>
      <p class="text-xs text-gray-500 mb-3">Consortium hospitalization counts at each inclusion step.</p>
      <div style="height: 360px;"><canvas id={`strobe-chart-${uid}`}></canvas></div>
    </div>
  )}
</div>

<script define:vars={{ uid, payload }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('outcomes-' + uid);
    if (!root) return;
    const data = JSON.parse(payload);
    let built = false;

    function build() {
      if (built || typeof Chart === 'undefined') return;
      built = true;

      // SOFA -> mortality with CI band.
      const sofaEl = document.getElementById('sofa-chart-' + uid);
      if (sofaEl && data.sofa.length) {
        new Chart(sofaEl, {
          type: 'line',
          data: {
            labels: data.sofa.map((d) => d.score),
            datasets: [
              { label: 'Upper 95% CI', data: data.sofa.map((d) => d.hi), borderWidth: 0, pointRadius: 0,
                backgroundColor: 'rgba(136, 19, 55, 0.12)', fill: '+1' },
              { label: 'Lower 95% CI', data: data.sofa.map((d) => d.lo), borderWidth: 0, pointRadius: 0, fill: false },
              { label: 'Mortality %', data: data.sofa.map((d) => d.mortality),
                borderColor: 'rgb(136, 19, 55)', backgroundColor: 'rgb(136, 19, 55)', borderWidth: 2,
                pointRadius: 2, fill: false, tension: 0.25 },
            ],
          },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              datalabels: { display: false },
              tooltip: {
                callbacks: {
                  title: (c) => 'SOFA ' + c[0].label,
                  label: (c) => c.datasetIndex === 2
                    ? 'Mortality: ' + c.parsed.y.toFixed(1) + '%'
                    : (c.datasetIndex === 0 ? 'Upper 95% CI: ' : 'Lower 95% CI: ') + c.parsed.y.toFixed(1) + '%',
                },
              },
            },
            scales: {
              x: { title: { display: true, text: 'SOFA score' } },
              y: { title: { display: true, text: 'In-hospital mortality (%)' }, beginAtZero: true },
            },
          },
        });
      }

      // Comorbidities per 1,000 (horizontal bar).
      const comorbEl = document.getElementById('comorb-chart-' + uid);
      if (comorbEl && data.comorb.length) {
        new Chart(comorbEl, {
          type: 'bar',
          data: {
            labels: data.comorb.map((d) => d.name),
            datasets: [{ label: 'per 1,000', data: data.comorb.map((d) => d.per1000),
              backgroundColor: 'rgba(79, 70, 229, 0.75)', borderColor: 'rgb(79, 70, 229)', borderWidth: 1 }],
          },
          options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            plugins: {
              legend: { display: false }, datalabels: { display: false },
              tooltip: { callbacks: { label: (c) => c.parsed.x.toFixed(1) + ' per 1,000' + (data.comorb[c.dataIndex].pct != null ? ' (' + data.comorb[c.dataIndex].pct.toFixed(1) + '%)' : '') } },
            },
            scales: { x: { title: { display: true, text: 'per 1,000 hospitalizations' }, beginAtZero: true } },
          },
        });
      }
      // Code status by encounter type (stacked bar, % within type).
      const csEl = document.getElementById('codestatus-chart-' + uid);
      if (csEl && data.codeStatus) {
        const cs = data.codeStatus;
        const palette = ['rgb(136,19,55)','rgb(190,18,60)','rgb(225,29,72)','rgb(251,113,133)','rgb(79,70,229)','rgb(99,102,241)','rgb(14,165,233)','rgb(20,184,166)','rgb(148,163,184)'];
        const datasets = cs.statuses.map((st, i) => ({
          label: st,
          data: cs.encounterTypes.map((et) => cs.map[et][st] || 0),
          backgroundColor: palette[i % palette.length],
        }));
        new Chart(csEl, {
          type: 'bar',
          data: { labels: cs.encounterTypes, datasets },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 12 } }, datalabels: { display: false },
              tooltip: { callbacks: { label: (c) => c.dataset.label + ': ' + c.parsed.y.toFixed(1) + '%' } } },
            scales: { x: { stacked: true }, y: { stacked: true, title: { display: true, text: '% of encounter type' } } },
          },
        });
      }

      // Critical-care criteria overlap (horizontal bar by combination).
      const upEl = document.getElementById('upset-chart-' + uid);
      if (upEl && data.upset && data.upset.length) {
        new Chart(upEl, {
          type: 'bar',
          data: { labels: data.upset.map((d) => d.label), datasets: [{ label: 'Hospitalizations', data: data.upset.map((d) => d.n), backgroundColor: 'rgba(13,148,136,0.75)', borderColor: 'rgb(13,148,136)', borderWidth: 1 }] },
          options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, datalabels: { display: false },
              tooltip: { callbacks: { label: (c) => c.parsed.x.toLocaleString() + ' hospitalizations' } } },
            scales: { x: { title: { display: true, text: 'hospitalizations' }, beginAtZero: true } },
          },
        });
      }

      // STROBE cohort-construction funnel (horizontal bar in step order).
      const stEl = document.getElementById('strobe-chart-' + uid);
      if (stEl && data.strobe && data.strobe.length) {
        new Chart(stEl, {
          type: 'bar',
          data: { labels: data.strobe.map((d) => d.label), datasets: [{ label: 'Hospitalizations', data: data.strobe.map((d) => d.value), backgroundColor: 'rgba(136,19,55,0.75)', borderColor: 'rgb(136,19,55)', borderWidth: 1 }] },
          options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, datalabels: { display: false },
              tooltip: { callbacks: { label: (c) => c.parsed.x.toLocaleString() } } },
            scales: { x: { title: { display: true, text: 'hospitalizations' }, beginAtZero: true } },
          },
        });
      }
    }

    if (window.CohortBus && typeof window.CohortBus.subscribe === 'function') {
      window.CohortBus.subscribe((key) => {
        const active = key === uid;
        root.classList.toggle('hidden', !active);
        if (active) build();
      });
    } else {
      build();
    }
  });
</script>
