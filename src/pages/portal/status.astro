---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalNav from '../../components/portal/PortalNav.astro';
import { getDb } from '../../lib/turso';
import {
  MANUSCRIPT_STATUS_TAGS,
  STATUS_PROGRESSION,
  normalizeStatus,
  latestStatus,
  statusLabel,
  statusClasses,
} from '../../lib/manuscript-status.js';
import {
  PRIORITY_ORDER,
  PRIORITY_EMPTY_CLASSES,
  normalizePriority,
  priorityLabel,
  priorityClasses,
  priorityRank,
} from '../../lib/manuscript-priority.js';
import { isNamedOnManuscript } from '../../lib/manuscript-access';
import { abbreviateSites, siteAliasMap } from '../../lib/site-abbreviations';
import { parseName } from '../../lib/format-byline';

// Row display: abbreviate first names ("William Parker" -> "W. Parker").
// First tokens that are already initials ("J.C.") are kept as-is. Selects
// (filters and the edit modal) keep full names.
function abbrevName(full: string | null | undefined): string {
  const { first, middleInitials, last } = parseName(full);
  if (!first) return last;
  const firstAbbrev = /\./.test(first) || first.length <= 2 ? first : `${first[0]}.`;
  return [firstAbbrev, middleInitials, last].filter(Boolean).join(' ');
}

function abbrevNames(raw: string | null | undefined): string {
  return String(raw ?? '')
    .split(',')
    .map((n) => abbrevName(n.trim()))
    .filter(Boolean)
    .join(', ');
}

const user = Astro.locals.user;
const isAdmin = user?.role === 'admin';
// Any approved member may add/edit manuscripts. Deletion is limited to admins
// and people named on the manuscript (lead author / lead data scientist).
// Middleware already guarantees anyone viewing /portal/* is approved.
const canEdit = Boolean(user?.is_approved);

const db = getDb();
let manuscripts: any[] = [];
let error: string | null = null;

try {
  // Join users so we can show who last edited each row (updated_by is a user id).
  const result = await db.execute(
    `SELECT m.*, u.full_name AS updated_by_name
       FROM manuscripts m
       LEFT JOIN users u ON m.updated_by = u.id
      ORDER BY m.sort_order, m.title`
  );
  manuscripts = result.rows;
} catch (e: any) {
  error = e.message;
}

// Consortium sites for the "Contributing sites" checklist in the add/edit modal.
let siteNames: string[] = [];
try {
  const sitesRes = await db.execute('SELECT site_name FROM site_details ORDER BY site_name');
  siteNames = sitesRes.rows.map((r) => r.site_name as string);
} catch {
  /* non-fatal: fall back to an empty checklist */
}

// Canonical CLIF versions, derived from the data-dictionary content files so the
// dropdown stays in sync with the versions the site actually documents. Latest first.
const clifVersions = Object.keys(
  import.meta.glob('../../content/clif-data-dictionary-*.md')
)
  .map((p) => p.match(/clif-data-dictionary-(.+)\.md$/)?.[1])
  .filter((v): v is string => Boolean(v) && v !== '1.0.0')
  .sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));

// Approved members for the "Lead authors" checklist and "Validation buddy" dropdown.
let memberNames: string[] = [];
try {
  const membersRes = await db.execute(
    "SELECT full_name FROM users WHERE is_approved = 1 AND full_name IS NOT NULL AND TRIM(full_name) != '' ORDER BY full_name"
  );
  memberNames = membersRes.rows.map((r) => r.full_name as string);
} catch {
  /* non-fatal: fall back to an empty list */
}

// Precompute the canonical status slugs for rendering chips + client editing.
const rows = manuscripts.map((m) => {
  const statusSlugs = normalizeStatus(m.status as string | null);
  // Stored values predating the column, or hand-edited ones, resolve to null
  // rather than rendering an unknown chip.
  const prioritySlug = normalizePriority(m.priority as string | null);
  // Precomputed lowercase haystack for the search box. Built server-side so it
  // isn't polluted by the inline status <select> options (which contain every
  // label) and still matches on any status tag the manuscript carries.
  const searchText = [
    m.title,
    m.lead_author,
    m.lead_authors,
    m.lead_data_scientist,
    m.journal,
    m.clif_version,
    m.ats,
    m.contributing_sites,
    abbreviateSites(m.contributing_sites as string),
    m.lead_site,
    abbreviateSites(m.lead_site as string),
    m.validation_buddy,
    m.notes,
    ...statusSlugs.map((s: string) => statusLabel(s)),
    prioritySlug ? priorityLabel(prioritySlug) : null,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return {
    ...m,
    statusSlugs,
    prioritySlug,
    latest: latestStatus(statusSlugs) as string | null,
    searchText,
    canDelete: isAdmin || isNamedOnManuscript(user?.full_name, m),
  };
});

// slug -> Tailwind chip classes, handed to the client so the inline status
// dropdown can recolor itself when an admin changes a manuscript's status.
const statusClassMap: Record<string, string> = {};
for (const slug of Object.keys(MANUSCRIPT_STATUS_TAGS)) {
  statusClassMap[slug] = statusClasses(slug);
}
const STATUS_EMPTY_CLASSES = 'bg-gray-100 text-gray-600 dark:bg-neutral-700 dark:text-gray-400';

// Same trick for priority, so the inline priority dropdown can recolor itself.
const priorityClassMap: Record<string, string> = {};
for (const slug of PRIORITY_ORDER) priorityClassMap[slug] = priorityClasses(slug);
const priorityOptions = PRIORITY_ORDER.map((slug) => ({ slug, label: priorityLabel(slug) }));
const priorityRanks: Record<string, number> = { _unset: priorityRank(null) };
for (const slug of PRIORITY_ORDER) priorityRanks[slug] = priorityRank(slug);

// Status tag options for the admin add/edit form (in canonical order).
const statusOptions = Object.entries(MANUSCRIPT_STATUS_TAGS).map(([slug, t]) => ({
  slug,
  label: t.label,
}));

// Distinct values present in each column, powering the per-column filter
// dropdowns in the table header. Comma-separated columns (lead authors,
// contributing sites) are exploded into individual tokens so each name/site is
// its own option. Case-insensitive de-dupe, alphabetical.
const distinctValues = (vals: (string | null | undefined)[]): string[] => {
  const seen = new Map<string, string>();
  for (const v of vals) {
    for (const part of String(v ?? '').split(',')) {
      const t = part.trim();
      if (t && !seen.has(t.toLowerCase())) seen.set(t.toLowerCase(), t);
    }
  }
  return [...seen.values()].sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
};
const colFilterOptions = {
  lead: distinctValues(rows.map((m) => m.lead_authors as string)),
  leadauthor: distinctValues(rows.map((m) => m.lead_author as string)),
  lds: distinctValues(rows.map((m) => m.lead_data_scientist as string)),
  journal: distinctValues(rows.map((m) => m.journal as string)),
  ats: distinctValues(rows.map((m) => m.ats as string)),
  leadsite: distinctValues(rows.map((m) => abbreviateSites(m.lead_site as string))),
  csites: distinctValues(rows.map((m) => abbreviateSites(m.contributing_sites as string))),
  buddy: distinctValues(rows.map((m) => m.validation_buddy as string)),
};

// Minimal payload handed to the client modal for editing existing rows.
const editData = rows.map((m) => ({
  id: m.id,
  title: m.title ?? '',
  clif_version: m.clif_version ?? '',
  ats: m.ats ?? '',
  lead_author: m.lead_author ?? '',
  lead_authors: m.lead_authors ?? '',
  lead_data_scientist: m.lead_data_scientist ?? '',
  journal: m.journal ?? '',
  contributing_sites: m.contributing_sites ?? '',
  lead_site: m.lead_site ?? '',
  validation_buddy: m.validation_buddy ?? '',
  priority: m.prioritySlug ?? '',
  github_repo: m.github_repo ?? '',
  manuscript_link: m.manuscript_link ?? '',
  cite: m.cite ?? '',
  notes: m.notes ?? '',
  status: m.statusSlugs,
}));

const inputClass =
  'w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent';

// Compact control used by the per-column filter row in the table header.
const filterCtrlClass =
  'col-filter w-full min-w-[7rem] px-2 py-1 text-xs font-normal tracking-normal text-gray-700 dark:text-gray-200 bg-white dark:bg-neutral-700 border border-gray-300 dark:border-neutral-600 rounded focus:outline-none focus:ring-1 focus:ring-clif-burgundy';
---

<BaseLayout title="Manuscript Tracker">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <aside class="lg:w-64 shrink-0">
        <PortalNav currentPath={Astro.url.pathname} isAdmin={isAdmin} />
      </aside>

      <div id="tracker-main" class="flex-1 min-w-0">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Manuscript Tracker</h1>
          <p class="text-gray-600 dark:text-gray-400 mt-1">
            Consortium manuscripts and their progress — status, leads, journals, and repositories
          </p>
        </div>

        {/* Progress map: the lifecycle a manuscript moves through. Each row shows its furthest-along stage. */}
        <div class="mb-6 bg-gradient-to-br from-white to-gray-50 dark:from-neutral-800 dark:to-neutral-800/60 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 p-5">
          <div class="flex items-baseline justify-between gap-2 mb-4">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Manuscript progress</h2>
            <span class="text-xs text-gray-400 dark:text-gray-500">each row shows its furthest stage</span>
          </div>
          <ol class="grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-7 gap-x-2 gap-y-4">
            {STATUS_PROGRESSION.map((slug, i) => (
              <li class="flex flex-col items-center text-center gap-1.5">
                <span class={`flex items-center justify-center w-7 h-7 rounded-full text-[11px] font-bold shadow-sm ${statusClasses(slug)}`}>
                  {i + 1}
                </span>
                <span class="text-[11px] font-semibold leading-tight text-gray-700 dark:text-gray-200">
                  {statusLabel(slug)}
                </span>
              </li>
            ))}
          </ol>
        </div>

        {/* Tabs */}
        <div class="mb-6">
          <div class="flex border-b border-gray-200 dark:border-neutral-700">
            {canEdit && (
              <button id="tab-add" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
                Add a Manuscript
              </button>
            )}
            <button id="tab-active" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-clif-burgundy text-clif-burgundy transition-colors">
              Active Manuscripts
            </button>
            <button id="tab-all" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
              All Manuscripts
            </button>
            <button
              type="button"
              id="tracker-expand"
              class="ml-auto self-center shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-300 dark:border-neutral-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-clif-burgundy hover:border-clif-burgundy dark:hover:text-clif-burgundy transition-colors"
              aria-label="Expand to full screen"
              title="Expand to full screen"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 expand-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 collapse-icon hidden">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" />
              </svg>
              <span class="expand-label">Expand</span>
            </button>
          </div>
        </div>

        {canEdit && (
          <div id="panel-add" class="tab-panel hidden">
            <div class="bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 p-6">
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Add a manuscript</h2>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 mb-4">Add a new consortium manuscript to the tracker.</p>
              <button
                id="add-manuscript-btn"
                class="bg-clif-burgundy hover:bg-clif-burgundy/90 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors"
              >
                + Add manuscript
              </button>
            </div>
          </div>
        )}

        {error ? (
          <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 rounded-lg p-4 text-sm">
            Error loading data: {error}
          </div>
        ) : (
          <div id="panel-table" class="tab-panel">
          <div class="bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 overflow-hidden">
            {rows.length === 0 ? (
              <div class="p-8 text-center text-gray-500 dark:text-gray-400">No manuscripts tracked yet.</div>
            ) : (
              <div class="overflow-auto max-h-[75vh]">
                <table class="w-full text-sm" id="manuscripts-table">
                  <thead class="sticky top-0 z-30">
                    <tr class="bg-gray-50 dark:bg-neutral-700 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">
                      <th class="px-4 py-3 min-w-[18rem]" data-sort-key="title"><span class="th-label">Title</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="priority"><span class="th-label">Priority</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="leadsite"><span class="th-label">Lead site</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="leadauthor"><span class="th-label">Lead author</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="lds"><span class="th-label">Lead data scientist</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="lead"><span class="th-label">Authors</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3" data-sort-key="status"><span class="th-label">Status</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="journal"><span class="th-label">Journal</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="ats"><span class="th-label">ATS</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="csites"><span class="th-label">Contributing sites</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="buddy"><span class="th-label">Validation buddy</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="github"><span class="th-label">GitHub</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="mslink"><span class="th-label">Manuscript</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 min-w-[12rem]" data-sort-key="notes"><span class="th-label">Notes</span><span class="sort-ind"></span></th>
                      <th class="px-4 py-3 whitespace-nowrap" data-sort-key="edited"><span class="th-label">Last edited</span><span class="sort-ind"></span></th>
                      {canEdit && <th class="px-4 py-3 whitespace-nowrap">Actions</th>}
                    </tr>
                    <tr class="bg-gray-50 dark:bg-neutral-700 border-t border-gray-200 dark:border-neutral-700 align-top">
                      <th class="px-4 pb-3 font-normal normal-case">
                        <input type="text" data-filter-attr="data-sort-title" data-filter-mode="text" placeholder="Filter title…" class={filterCtrlClass} aria-label="Filter by title" />
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        {/* Filters on data-priority (the slug) rather than
                            data-sort-priority (a numeric rank), so "Not set"
                            is expressible as its own option. */}
                        <select data-filter-attr="data-priority" data-filter-mode="eq" class={filterCtrlClass} aria-label="Filter by priority">
                          <option value="">All</option>
                          {priorityOptions.map((opt) => <option value={opt.slug}>{opt.label}</option>)}
                          <option value="none">Not set</option>
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-leadsite" data-filter-mode="multi" class={filterCtrlClass} aria-label="Filter by lead site">
                          <option value="">All</option>
                          {colFilterOptions.leadsite.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-leadauthor" data-filter-mode="multi" class={filterCtrlClass} aria-label="Filter by lead author">
                          <option value="">All</option>
                          {colFilterOptions.leadauthor.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-lds" data-filter-mode="multi" class={filterCtrlClass} aria-label="Filter by lead data scientist">
                          <option value="">All</option>
                          {colFilterOptions.lds.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-lead" data-filter-mode="multi" class={filterCtrlClass} aria-label="Filter by author">
                          <option value="">All</option>
                          {colFilterOptions.lead.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-status" data-filter-mode="multi" class={filterCtrlClass} aria-label="Filter by status">
                          <option value="">All</option>
                          {statusOptions.map((opt) => <option value={opt.slug}>{opt.label}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-journal" data-filter-mode="eq" class={filterCtrlClass} aria-label="Filter by journal">
                          <option value="">All</option>
                          {colFilterOptions.journal.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-ats" data-filter-mode="eq" class={filterCtrlClass} aria-label="Filter by ATS">
                          <option value="">All</option>
                          {colFilterOptions.ats.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-csites" data-filter-mode="multi" class={filterCtrlClass} aria-label="Filter by contributing site">
                          <option value="">All</option>
                          {colFilterOptions.csites.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-buddy" data-filter-mode="eq" class={filterCtrlClass} aria-label="Filter by validation buddy">
                          <option value="">All</option>
                          {colFilterOptions.buddy.map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-github" data-filter-mode="github" class={filterCtrlClass} aria-label="Filter by GitHub repo">
                          <option value="">All</option>
                          <option value="repo">Has repo</option>
                          <option value="none">No repo</option>
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <select data-filter-attr="data-sort-mslink" data-filter-mode="github" class={filterCtrlClass} aria-label="Filter by manuscript link">
                          <option value="">All</option>
                          <option value="repo">Has link</option>
                          <option value="none">No link</option>
                        </select>
                      </th>
                      <th class="px-4 pb-3 font-normal normal-case">
                        <input type="text" data-filter-attr="data-sort-notes" data-filter-mode="text" placeholder="Filter notes…" class={filterCtrlClass} aria-label="Filter by notes" />
                      </th>
                      <th class="px-4 pb-3"></th>
                      {canEdit && <th class="px-4 pb-3"></th>}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200 dark:divide-neutral-700">
                    {rows.map((m, i) => (
                      <tr
                        class={`align-top hover:bg-gray-50 dark:hover:bg-neutral-700 transition-colors ${i % 2 === 0 ? 'bg-white dark:bg-neutral-800' : 'bg-gray-50 dark:bg-neutral-800'}`}
                        data-search-row
                        data-search-text={m.searchText}
                        data-published={m.statusSlugs.includes('published') ? '1' : '0'}
                        data-status={m.statusSlugs.join(',')}
                        data-sort-title={(m.title ?? '').toLowerCase()}
                        data-sort-lead={(m.lead_authors ?? '').toLowerCase()}
                        data-sort-leadauthor={(m.lead_author ?? '').toLowerCase()}
                        data-sort-lds={(m.lead_data_scientist ?? '').toLowerCase()}
                        data-sort-status={m.latest ? STATUS_PROGRESSION.indexOf(m.latest) : -1}
                        data-priority={m.prioritySlug ?? 'none'}
                        data-sort-priority={priorityRank(m.prioritySlug)}
                        data-sort-journal={(m.journal ?? '').toLowerCase()}
                        data-sort-ats={(m.ats ?? '').toLowerCase()}
                        data-sort-leadsite={abbreviateSites(m.lead_site as string).toLowerCase()}
                        data-sort-csites={abbreviateSites(m.contributing_sites as string).toLowerCase()}
                        data-sort-buddy={(m.validation_buddy ?? '').toLowerCase()}
                        data-sort-github={(m.github_repo ?? '').toLowerCase()}
                        data-sort-mslink={(m.manuscript_link ?? '').toLowerCase()}
                        data-sort-notes={(m.notes ?? '').toLowerCase()}
                        data-sort-edited={m.updated_at ? Date.parse(m.updated_at as string) : 0}
                      >
                        <td class="px-4 py-3 text-gray-900 dark:text-gray-200">
                          {m.manuscript_link ? (
                            <a href={m.manuscript_link} target="_blank" rel="noopener noreferrer" class="font-medium text-clif-burgundy hover:underline">
                              {m.title}
                            </a>
                          ) : (
                            <span class="font-medium">{m.title}</span>
                          )}
                          {m.clif_version && (
                            <span class="inline-flex items-center align-middle ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-clif-burgundy/10 text-clif-burgundy dark:bg-clif-burgundy/20 whitespace-nowrap" title="CLIF version">
                              v{String(m.clif_version).replace(/\.0$/, '')}
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3">
                          {canEdit ? (
                            <select
                              class={`priority-select w-28 max-w-full truncate cursor-pointer rounded-full text-xs font-medium pl-2.5 pr-7 py-1 border-0 focus:outline-none focus:ring-2 focus:ring-clif-burgundy ${m.prioritySlug ? priorityClasses(m.prioritySlug) : PRIORITY_EMPTY_CLASSES}`}
                              data-id={m.id}
                              aria-label="Priority"
                            >
                              <option value="">—</option>
                              {PRIORITY_ORDER.map((slug) => (
                                <option value={slug} selected={m.prioritySlug === slug}>{priorityLabel(slug)}</option>
                              ))}
                            </select>
                          ) : m.prioritySlug ? (
                            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${priorityClasses(m.prioritySlug)}`}>
                              {priorityLabel(m.prioritySlug)}
                            </span>
                          ) : (
                            <span class="text-gray-400">—</span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 max-w-[14rem]" title={m.lead_site ?? undefined}>{m.lead_site ? abbreviateSites(m.lead_site as string) : '—'}</td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 max-w-[14rem]" title={m.lead_author ?? undefined}>{m.lead_author ? abbrevNames(m.lead_author as string) : '—'}</td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 max-w-[14rem]" title={m.lead_data_scientist ?? undefined}>{m.lead_data_scientist ? abbrevNames(m.lead_data_scientist as string) : '—'}</td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 max-w-[16rem]" title={m.lead_authors ?? undefined}>{m.lead_authors ? abbrevNames(m.lead_authors as string) : '—'}</td>
                        <td class="px-4 py-3">
                          {canEdit ? (
                            <select
                              class={`status-select w-40 max-w-full truncate cursor-pointer rounded-full text-xs font-medium pl-2.5 pr-7 py-1 border-0 focus:outline-none focus:ring-2 focus:ring-clif-burgundy ${m.latest ? statusClasses(m.latest) : STATUS_EMPTY_CLASSES}`}
                              data-id={m.id}
                            >
                              <option value="">—</option>
                              {m.latest && !STATUS_PROGRESSION.includes(m.latest) && (
                                <option value={m.latest} selected>{statusLabel(m.latest)}</option>
                              )}
                              {STATUS_PROGRESSION.map((slug) => (
                                <option value={slug} selected={m.latest === slug}>{statusLabel(slug)}</option>
                              ))}
                            </select>
                          ) : m.latest ? (
                            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusClasses(m.latest)}`}>
                              {statusLabel(m.latest)}
                            </span>
                          ) : (
                            <span class="text-gray-400">—</span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 max-w-[14rem]">{m.journal ?? '—'}</td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 whitespace-nowrap">{m.ats ?? '—'}</td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 max-w-[16rem]" title={m.contributing_sites ?? undefined}>{m.contributing_sites ? abbreviateSites(m.contributing_sites as string) : '—'}</td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300 whitespace-nowrap" title={m.validation_buddy ?? undefined}>{m.validation_buddy ? abbrevName(m.validation_buddy as string) : '—'}</td>
                        <td class="px-4 py-3 whitespace-nowrap">
                          {m.github_repo ? (
                            <a href={m.github_repo} target="_blank" rel="noopener noreferrer" class="text-clif-burgundy hover:underline">Repo</a>
                          ) : (
                            <span class="text-gray-400">—</span>
                          )}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                          {m.manuscript_link ? (
                            <a href={m.manuscript_link} target="_blank" rel="noopener noreferrer" class="text-clif-burgundy hover:underline">Link</a>
                          ) : (
                            <span class="text-gray-400">—</span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-gray-600 dark:text-gray-400">{m.notes ?? '—'}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
                          {m.updated_at ? (
                            <Fragment>
                              {m.updated_by_name && (
                                <div class="font-medium text-gray-700 dark:text-gray-300">{m.updated_by_name}</div>
                              )}
                              <div>{new Date(m.updated_at as string).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}</div>
                            </Fragment>
                          ) : (
                            <span class="text-gray-400">—</span>
                          )}
                        </td>
                        {canEdit && (
                          <td class="px-4 py-3 whitespace-nowrap">
                            <div class="flex gap-3">
                              <button class="edit-manuscript-btn text-xs text-clif-burgundy hover:underline font-medium" data-id={m.id}>Edit</button>
                              {m.canDelete && (
                                <button class="delete-manuscript-btn text-xs text-red-600 dark:text-red-400 hover:underline" data-id={m.id} data-title={m.title}>Delete</button>
                              )}
                            </div>
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <div id="manuscripts-empty" class="hidden p-8 text-center text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-neutral-700">
              No manuscripts match this view.
            </div>

            <div class="p-3 border-t border-gray-200 dark:border-neutral-700 text-xs text-gray-500 dark:text-gray-400 flex items-center justify-between gap-3">
              <span><span id="manuscripts-count">{rows.length}</span> {rows.length === 1 ? 'manuscript' : 'manuscripts'}</span>
              <button
                type="button"
                id="reset-filters"
                class="hidden px-3 py-1.5 rounded-lg text-xs font-medium text-clif-burgundy border border-clif-burgundy/40 hover:bg-clif-burgundy/5 dark:hover:bg-clif-burgundy/10 focus:outline-none focus:ring-2 focus:ring-clif-burgundy transition-colors whitespace-nowrap"
              >
                Reset filters
              </button>
            </div>
          </div>
          </div>
        )}
      </div>
    </div>
  </div>

  {canEdit && (
    <dialog id="manuscript-modal" class="rounded-xl p-0 w-full max-w-2xl backdrop:bg-black/40 bg-white dark:bg-neutral-800 text-gray-900 dark:text-white">
      <form id="manuscript-form" class="p-6 space-y-4">
        <h2 id="manuscript-modal-title" class="text-lg font-semibold">Add manuscript</h2>
        <input type="hidden" id="m-id" />

        <div>
          <label for="m-title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title <span class="text-red-500">*</span></label>
          <input type="text" id="m-title" required class={inputClass} />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="m-journal" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Journal</label>
            <input type="text" id="m-journal" class={inputClass} />
          </div>
          <div>
            <label for="m-clif_version" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">CLIF version</label>
            <select id="m-clif_version" class={inputClass}>
              <option value="">—</option>
              {clifVersions.map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="m-ats" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ATS</label>
            <input type="text" id="m-ats" class={inputClass} placeholder="e.g. ATS 2026" />
          </div>
          <div>
            <label for="m-priority" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Priority</label>
            <select id="m-priority" class={inputClass}>
              <option value="">—</option>
              {priorityOptions.map((opt) => (
                <option value={opt.slug}>{opt.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="m-validation_buddy" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Validation buddy</label>
            <select id="m-validation_buddy" class={inputClass}>
              <option value="">—</option>
              {memberNames.map((name) => (
                <option value={name}>{name}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="m-github_repo" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">GitHub repository</label>
            <input type="url" id="m-github_repo" class={inputClass} placeholder="https://github.com/…" />
          </div>
          <div>
            <label for="m-manuscript_link" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Manuscript link</label>
            <input type="url" id="m-manuscript_link" class={inputClass} placeholder="https://…" />
          </div>
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lead author(s)</span>
          {memberNames.length > 0 && (
            <div class="max-h-36 overflow-y-auto border border-gray-200 dark:border-neutral-600 rounded-lg p-3 flex flex-wrap gap-x-4 gap-y-2">
              {memberNames.map((name) => (
                <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                  <input type="checkbox" class="m-leadauthor w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={name} />
                  {name}
                </label>
              ))}
            </div>
          )}
          <input type="text" id="m-lead_author_other" class={`${inputClass} mt-2`} placeholder="Other lead authors (comma-separated)" />
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lead data scientist(s)</span>
          {memberNames.length > 0 && (
            <div class="max-h-36 overflow-y-auto border border-gray-200 dark:border-neutral-600 rounded-lg p-3 flex flex-wrap gap-x-4 gap-y-2">
              {memberNames.map((name) => (
                <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                  <input type="checkbox" class="m-lds w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={name} />
                  {name}
                </label>
              ))}
            </div>
          )}
          <input type="text" id="m-lead_data_scientist_other" class={`${inputClass} mt-2`} placeholder="Other lead data scientists (comma-separated)" />
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Authors</span>
          {memberNames.length > 0 && (
            <div class="max-h-36 overflow-y-auto border border-gray-200 dark:border-neutral-600 rounded-lg p-3 flex flex-wrap gap-x-4 gap-y-2">
              {memberNames.map((name) => (
                <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                  <input type="checkbox" class="m-lead-author w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={name} />
                  {name}
                </label>
              ))}
            </div>
          )}
          <input type="text" id="m-lead_authors_other" class={`${inputClass} mt-2`} placeholder="Other authors (comma-separated)" />
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lead site(s)</span>
          {siteNames.length > 0 && (
            <div class="max-h-36 overflow-y-auto border border-gray-200 dark:border-neutral-600 rounded-lg p-3 flex flex-wrap gap-x-4 gap-y-2">
              {siteNames.map((name) => (
                <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                  <input type="checkbox" class="m-leadsite w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={name} />
                  {name}
                </label>
              ))}
            </div>
          )}
          <input type="text" id="m-lead_site_other" class={`${inputClass} mt-2`} placeholder="Other lead sites (comma-separated)" />
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Contributing sites</span>
          {siteNames.length > 0 && (
            <div class="max-h-36 overflow-y-auto border border-gray-200 dark:border-neutral-600 rounded-lg p-3 flex flex-wrap gap-x-4 gap-y-2">
              {siteNames.map((name) => (
                <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                  <input type="checkbox" class="m-site w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={name} />
                  {name}
                </label>
              ))}
            </div>
          )}
          <input type="text" id="m-contributing_sites_other" class={`${inputClass} mt-2`} placeholder="Other sites (comma-separated)" />
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Status</span>
          <div class="flex flex-wrap gap-x-4 gap-y-2">
            {statusOptions.map((opt) => (
              <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox" class="m-status w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={opt.slug} />
                {opt.label}
              </label>
            ))}
          </div>
        </div>

        <div>
          <label for="m-cite" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Citation</label>
          <input type="text" id="m-cite" class={inputClass} />
        </div>

        <div>
          <label for="m-notes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes</label>
          <textarea id="m-notes" rows="2" class={inputClass}></textarea>
        </div>

        <div id="manuscript-error" class="hidden text-sm text-red-600 dark:text-red-400"></div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="manuscript-cancel" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-neutral-700 transition-colors">Cancel</button>
          <button type="submit" id="manuscript-save" class="bg-clif-burgundy hover:bg-clif-burgundy/90 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors">Save</button>
        </div>
      </form>
    </dialog>
  )}

  <script is:inline define:vars={{ manuscripts: editData, canEdit, statusClassMap, statusEmptyClasses: STATUS_EMPTY_CLASSES, priorityClassMap, priorityEmptyClasses: PRIORITY_EMPTY_CLASSES, priorityRanks, siteAliases: siteAliasMap() }}>
    document.addEventListener('DOMContentLoaded', function () {
      // ---- Sub-tabs (Add / Active / All) + per-column filters ----
      var table = document.getElementById('manuscripts-table');
      var countEl = document.getElementById('manuscripts-count');
      var emptyEl = document.getElementById('manuscripts-empty');
      var tabAdd = document.getElementById('tab-add');
      var tabActive = document.getElementById('tab-active');
      var tabAll = document.getElementById('tab-all');
      var panelAdd = document.getElementById('panel-add');
      var panelTable = document.getElementById('panel-table');

      // Per-column filter controls in the header's second row. Each carries
      // data-filter-attr (the row attribute to read) and data-filter-mode.
      var colFilters = table ? Array.prototype.slice.call(table.querySelectorAll('.col-filter')) : [];
      var resetBtn = document.getElementById('reset-filters');

      var rowFilter = 'active'; // 'active' = not published, 'all' = everything

      // Does one column control's current value match a given row?
      function matchesColumn(ctrl, row) {
        var val = ctrl.value;
        if (!val) return true; // empty control = no constraint
        var rv = (row.getAttribute(ctrl.getAttribute('data-filter-attr')) || '').toLowerCase();
        var needle = val.toLowerCase();
        switch (ctrl.getAttribute('data-filter-mode')) {
          case 'text': return rv.indexOf(needle) !== -1;
          case 'eq': return rv === needle;
          case 'multi':
            return rv.split(',').some(function (t) { return t.trim() === needle; });
          case 'github': return val === 'repo' ? rv !== '' : rv === '';
          default: return true;
        }
      }

      // Show/hide the Reset button when any column filter is active.
      function anyFilterActive() {
        return colFilters.some(function (c) { return c.value; });
      }

      function applyFilters() {
        if (!table) return;
        var allRows = table.querySelectorAll('[data-search-row]');
        var visible = 0;
        allRows.forEach(function (row) {
          var matchesTab = rowFilter === 'all' || row.getAttribute('data-published') !== '1';
          var matchesCols = colFilters.every(function (c) { return matchesColumn(c, row); });
          var show = matchesTab && matchesCols;
          row.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (countEl) countEl.textContent = String(visible);
        if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0 || allRows.length === 0);
        if (resetBtn) resetBtn.classList.toggle('hidden', !anyFilterActive());
      }

      colFilters.forEach(function (ctrl) {
        var evt = ctrl.tagName === 'SELECT' ? 'change' : 'input';
        ctrl.addEventListener(evt, applyFilters);
        // Don't let clicks on a filter control bubble to a sortable header.
        ctrl.addEventListener('click', function (e) { e.stopPropagation(); });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          colFilters.forEach(function (c) { c.value = ''; });
          applyFilters();
        });
      }

      // ---- Sortable columns (click a header to sort; click again to reverse) ----
      var currentSort = { key: null, dir: 1 };

      function updateSortIndicators() {
        if (!table) return;
        table.querySelectorAll('th[data-sort-key]').forEach(function (th) {
          var ind = th.querySelector('.sort-ind');
          if (!ind) return;
          if (th.getAttribute('data-sort-key') === currentSort.key) {
            ind.textContent = currentSort.dir === 1 ? ' ▲' : ' ▼';
          } else {
            ind.textContent = '';
          }
        });
      }

      function sortBy(key) {
        if (!table) return;
        if (currentSort.key === key) currentSort.dir *= -1;
        else { currentSort.key = key; currentSort.dir = 1; }
        var tbody = table.querySelector('tbody');
        if (!tbody) return;
        var attr = 'data-sort-' + key;
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('[data-search-row]'));
        rows.sort(function (a, b) {
          var av = a.getAttribute(attr) || '';
          var bv = b.getAttribute(attr) || '';
          var an = parseFloat(av), bn = parseFloat(bv);
          var cmp;
          if (av !== '' && bv !== '' && !isNaN(an) && !isNaN(bn) && String(an) === av && String(bn) === bv) {
            cmp = an - bn; // numeric columns (status stage, last-edited timestamp)
          } else {
            cmp = av.localeCompare(bv);
          }
          return cmp * currentSort.dir;
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
        updateSortIndicators();
        applyFilters();
      }

      if (table) {
        table.querySelectorAll('th[data-sort-key]').forEach(function (th) {
          th.classList.add('cursor-pointer', 'select-none');
          th.title = 'Click to sort';
          th.addEventListener('click', function () {
            sortBy(th.getAttribute('data-sort-key'));
          });
        });
      }

      function setActiveTab(btn) {
        [tabAdd, tabActive, tabAll].forEach(function (b) {
          if (!b) return;
          b.classList.remove('border-clif-burgundy', 'text-clif-burgundy');
          b.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
        });
        btn.classList.add('border-clif-burgundy', 'text-clif-burgundy');
        btn.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
      }

      function showTable(filter, btn) {
        setActiveTab(btn);
        if (panelAdd) panelAdd.classList.add('hidden');
        if (panelTable) panelTable.classList.remove('hidden');
        rowFilter = filter;
        applyFilters();
      }

      if (tabAdd) tabAdd.addEventListener('click', function () {
        setActiveTab(tabAdd);
        if (panelTable) panelTable.classList.add('hidden');
        if (panelAdd) panelAdd.classList.remove('hidden');
      });
      if (tabActive) tabActive.addEventListener('click', function () { showTable('active', tabActive); });
      if (tabAll) tabAll.addEventListener('click', function () { showTable('all', tabAll); });

      // Default view: Active Manuscripts
      applyFilters();

      if (!canEdit) return;

      // ---- Inline status dropdown (quick-edit without opening the modal) ----
      // ---- Inline priority dropdown ----
      var PRIORITY_SELECT_BASE = 'priority-select w-28 max-w-full truncate cursor-pointer rounded-full text-xs font-medium pl-2.5 pr-7 py-1 border-0 focus:outline-none focus:ring-2 focus:ring-clif-burgundy';
      document.querySelectorAll('.priority-select').forEach(function (sel) {
        var prev = sel.value;
        sel.addEventListener('change', async function () {
          var slug = this.value;
          this.disabled = true;
          var res = await fetch('/api/manuscripts/update-priority', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: this.dataset.id, priority: slug }),
          });
          if (res.ok) {
            this.className = PRIORITY_SELECT_BASE + ' ' + (slug ? (priorityClassMap[slug] || priorityEmptyClasses) : priorityEmptyClasses);
            var row = this.closest('[data-search-row]');
            // Keep the column filter and the sort key honest after an edit.
            if (row) {
              row.setAttribute('data-priority', slug || 'none');
              row.setAttribute('data-sort-priority', String(priorityRanks[slug] != null ? priorityRanks[slug] : priorityRanks._unset));
            }
            prev = slug;
            applyFilters();
            this.disabled = false;
          } else {
            var data = await res.json().catch(function () { return {}; });
            alert(data.error || 'Failed to update priority');
            this.value = prev; // revert
            this.disabled = false;
          }
        });
      });

      var STATUS_SELECT_BASE = 'status-select w-40 max-w-full truncate cursor-pointer rounded-full text-xs font-medium pl-2.5 pr-7 py-1 border-0 focus:outline-none focus:ring-2 focus:ring-clif-burgundy';
      document.querySelectorAll('.status-select').forEach(function (sel) {
        var prev = sel.value;
        sel.addEventListener('change', async function () {
          var id = this.dataset.id;
          var slug = this.value;
          this.disabled = true;
          var res = await fetch('/api/manuscripts/update-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id, status: slug ? [slug] : [] }),
          });
          if (res.ok) {
            // Recolor the dropdown and keep Active/All filtering in sync.
            this.className = STATUS_SELECT_BASE + ' ' + (slug ? (statusClassMap[slug] || statusEmptyClasses) : statusEmptyClasses);
            var row = this.closest('[data-search-row]');
            if (row) row.setAttribute('data-published', slug === 'published' ? '1' : '0');
            prev = slug;
            applyFilters();
            this.disabled = false;
          } else {
            var data = await res.json().catch(function () { return {}; });
            alert(data.error || 'Failed to update status');
            this.value = prev; // revert
            this.disabled = false;
          }
        });
      });

      // ---- Add / edit modal ----
      var modal = document.getElementById('manuscript-modal');
      var form = document.getElementById('manuscript-form');
      var modalTitle = document.getElementById('manuscript-modal-title');
      var errorEl = document.getElementById('manuscript-error');
      var saveBtn = document.getElementById('manuscript-save');
      var byId = {};
      manuscripts.forEach(function (m) { byId[m.id] = m; });

      // lead_authors, contributing_sites, lead_site, lead_author and
      // lead_data_scientist are checkbox lists (multi-select, comma-joined);
      // validation_buddy and clif_version stay single-value dropdowns.
      var TEXT_FIELDS = ['title', 'journal', 'ats',
        'github_repo', 'manuscript_link', 'cite', 'notes'];

      function setField(name, value) {
        var el = document.getElementById('m-' + name);
        if (el) el.value = value || '';
      }

      // Check the boxes (class `cls`) whose value matches a name in the stored
      // comma-separated string; anything unmatched goes into the `otherId` input
      // so existing free-text values are preserved. `aliases` (optional) maps
      // lowercased alternate spellings (site abbreviations) to checkbox values.
      function setChecklist(cls, otherId, raw, aliases) {
        var boxes = form.querySelectorAll('.' + cls);
        var known = {};
        boxes.forEach(function (cb) { cb.checked = false; known[cb.value.toLowerCase()] = cb; });
        var leftover = [];
        String(raw || '').split(',').forEach(function (part) {
          var name = part.trim();
          if (!name) return;
          var key = name.toLowerCase();
          var cb = known[key] || (aliases && aliases[key] ? known[aliases[key].toLowerCase()] : null);
          if (cb) cb.checked = true;
          else leftover.push(name);
        });
        var otherEl = document.getElementById(otherId);
        if (otherEl) otherEl.value = leftover.join(', ');
      }

      // Read a checklist + its "other" input back into one comma-separated string.
      function readChecklist(cls, otherId) {
        var vals = [];
        form.querySelectorAll('.' + cls + ':checked').forEach(function (cb) { vals.push(cb.value); });
        var otherEl = document.getElementById(otherId);
        if (otherEl && otherEl.value.trim()) {
          otherEl.value.split(',').forEach(function (p) { if (p.trim()) vals.push(p.trim()); });
        }
        return vals.join(', ');
      }

      // Set a <select> to `value`, adding a matching option first if the stored
      // value isn't already in the list so existing data is preserved.
      function setSelectValue(id, value) {
        var sel = document.getElementById(id);
        if (!sel) return;
        var v = value || '';
        if (v && !Array.prototype.some.call(sel.options, function (o) { return o.value === v; })) {
          var opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          sel.appendChild(opt);
        }
        sel.value = v;
      }

      function openModal(data) {
        errorEl.classList.add('hidden');
        document.getElementById('m-id').value = data ? data.id : '';
        TEXT_FIELDS.forEach(function (f) { setField(f, data ? data[f] : ''); });
        setChecklist('m-lead-author', 'm-lead_authors_other', data ? data.lead_authors : '');
        setChecklist('m-site', 'm-contributing_sites_other', data ? data.contributing_sites : '', siteAliases);
        setChecklist('m-leadsite', 'm-lead_site_other', data ? data.lead_site : '', siteAliases);
        setChecklist('m-leadauthor', 'm-lead_author_other', data ? data.lead_author : '');
        setChecklist('m-lds', 'm-lead_data_scientist_other', data ? data.lead_data_scientist : '');
        setSelectValue('m-priority', data ? data.priority : '');
        setSelectValue('m-validation_buddy', data ? data.validation_buddy : '');
        setSelectValue('m-clif_version', data ? data.clif_version : '');
        var selected = data && data.status ? data.status : [];
        form.querySelectorAll('.m-status').forEach(function (cb) {
          cb.checked = selected.indexOf(cb.value) !== -1;
        });
        modalTitle.textContent = data ? 'Edit manuscript' : 'Add manuscript';
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save';
        modal.showModal();
      }

      var addBtn = document.getElementById('add-manuscript-btn');
      if (addBtn) addBtn.addEventListener('click', function () { openModal(null); });

      document.querySelectorAll('.edit-manuscript-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { openModal(byId[this.dataset.id]); });
      });

      var cancelBtn = document.getElementById('manuscript-cancel');
      if (cancelBtn) cancelBtn.addEventListener('click', function () { modal.close(); });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errorEl.classList.add('hidden');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';

        var id = document.getElementById('m-id').value;
        var payload = { status: [] };
        TEXT_FIELDS.forEach(function (f) {
          payload[f] = document.getElementById('m-' + f).value;
        });
        payload.lead_authors = readChecklist('m-lead-author', 'm-lead_authors_other');
        payload.contributing_sites = readChecklist('m-site', 'm-contributing_sites_other');
        payload.lead_site = readChecklist('m-leadsite', 'm-lead_site_other');
        payload.lead_author = readChecklist('m-leadauthor', 'm-lead_author_other');
        payload.lead_data_scientist = readChecklist('m-lds', 'm-lead_data_scientist_other');
        var priorityEl = document.getElementById('m-priority');
        payload.priority = priorityEl ? priorityEl.value : '';
        var buddyEl = document.getElementById('m-validation_buddy');
        payload.validation_buddy = buddyEl ? buddyEl.value : '';
        var clifEl = document.getElementById('m-clif_version');
        payload.clif_version = clifEl ? clifEl.value : '';
        form.querySelectorAll('.m-status:checked').forEach(function (cb) {
          payload.status.push(cb.value);
        });
        var endpoint = '/api/manuscripts/create';
        if (id) { payload.id = id; endpoint = '/api/manuscripts/update'; }

        var res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          var data = await res.json().catch(function () { return {}; });
          errorEl.textContent = data.error || 'Failed to save manuscript';
          errorEl.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
        }
      });

      // ---- Delete ----
      document.querySelectorAll('.delete-manuscript-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          if (!confirm('Delete "' + this.dataset.title + '"? This cannot be undone.')) return;
          var res = await fetch('/api/manuscripts/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: this.dataset.id }),
          });
          if (res.ok) window.location.reload();
          else alert('Failed to delete manuscript.');
        });
      });
    });
  </script>

  <style>
    /* Fullscreen presentation for the tracker: the fullscreened element gets a
       black backdrop by default, so restore page colors and make it scroll. */
    #tracker-main:fullscreen {
      overflow-y: auto;
      background: rgb(249 250 251); /* gray-50 */
      padding: 1.5rem 2rem;
    }
    :global(.dark) #tracker-main:fullscreen {
      background: rgb(23 23 23); /* neutral-900 */
    }

    /* Frozen title column: cells take their row's (opaque) background so
       scrolled columns pass underneath instead of showing through. */
    #manuscripts-table th:first-child,
    #manuscripts-table td:first-child {
      position: sticky;
      left: 0;
      z-index: 10;
      background-color: inherit;
    }
  </style>

  <script is:inline>
    (function () {
      var main = document.getElementById('tracker-main');
      var btn = document.getElementById('tracker-expand');
      if (!main || !btn || !main.requestFullscreen) {
        if (btn) btn.classList.add('hidden');
        return;
      }
      btn.addEventListener('click', function () {
        if (document.fullscreenElement) document.exitFullscreen();
        else main.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', function () {
        var expanded = document.fullscreenElement === main;
        btn.querySelector('.expand-icon').classList.toggle('hidden', expanded);
        btn.querySelector('.collapse-icon').classList.toggle('hidden', !expanded);
        btn.querySelector('.expand-label').textContent = expanded ? 'Exit' : 'Expand';
        btn.title = expanded ? 'Exit full screen' : 'Expand to full screen';
        btn.setAttribute('aria-label', btn.title);
      });
    })();
  </script>
</BaseLayout>
