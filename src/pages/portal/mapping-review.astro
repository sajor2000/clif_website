---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalNav from '../../components/portal/PortalNav.astro';
import MappingReview from '../../components/portal/MappingReview.astro';
import { getDb } from '../../lib/turso';
import type { FieldSummary } from '../../utils/mcideMappings';

const user = Astro.locals.user;

// One row per field; the docs themselves are fetched per field by the client.
let summaries: FieldSummary[] = [];
let runLabel: string | null = null;
let error: string | null = null;
try {
  const result = await getDb().execute(
    'SELECT field_key, run_label, summary, updated_at FROM mcide_mapping_docs ORDER BY field_key'
  );
  summaries = result.rows.map((row) => JSON.parse(String(row.summary)) as FieldSummary);
  if (result.rows.length > 0) {
    runLabel = String(result.rows[0].run_label);
  }
} catch (e: any) {
  error = e.message;
}
---

<BaseLayout title="mCIDE Surveyor">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <aside class="lg:w-64 shrink-0">
        <PortalNav currentPath={Astro.url.pathname} isAdmin={user?.role === 'admin'} />
      </aside>

      <div class="flex-1 min-w-0">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            mCIDE Surveyor
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-clif-burgundy/10 text-clif-burgundy border border-clif-burgundy/20" title="Mappings from sites' CLIF v2.1 tables">CLIF v2.1</span>
          </h1>
          <p class="text-gray-600 dark:text-gray-400 mt-1">
            What each site maps its raw EHR names to. Search a raw name to see what every site mapped it to —
            or browse a field, click a category, and see the raw names behind it.
          </p>
          {runLabel && (
            <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">Source: CLIF TableOne · members only — not for redistribution</p>
          )}
        </div>

        {error ? (
          <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 text-sm text-red-700 dark:text-red-400">
            Could not load mapping data: {error}
          </div>
        ) : summaries.length === 0 ? (
          <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4 text-sm text-amber-800 dark:text-amber-300">
            No mapping data has been loaded yet. Run <code>node --env-file=.env scripts/build-mcide-mappings.mjs</code>
            against the TableOne export to populate it.
          </div>
        ) : (
          <MappingReview summaries={summaries} isAdmin={user?.role === 'admin'} />
        )}
      </div>
    </div>
  </div>
</BaseLayout>
