---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalNav from '../../components/portal/PortalNav.astro';
import { getDb } from '../../lib/turso';
import { todayInConsortiumTz } from '../../lib/project-run-deadline';
import { PROJECT_RUN_VERSIONS } from '../../data/clif-tables';
import RequiredTablesPicker from '../../components/portal/RequiredTablesPicker.astro';
import { CURRENT_ATS, STATUS_BADGE, toProjectRunStatus } from '../../lib/project-run-status';

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';

const db = getDb();
let projects: any[] = [];
let sites: any[] = [];
const runMap: Record<string, Set<string>> = {};
// Sites marked N/A per project -> their (possibly empty) reason. N/A sites are
// not owed the run and drop out of the "N / M sites" denominator.
const naMap: Record<string, Map<string, string>> = {};
let editableSiteIds = new Set<string>();
let error: string | null = null;

try {
  const projectsResult = await db.execute({
    sql: `SELECT p.*, u.full_name as creator_name
          FROM project_runs p
          LEFT JOIN users u ON p.created_by = u.id
          -- Order by the number members actually see on the card, newest first.
          -- Sorting by status first made closing a run yank it to the top; using
          -- created_at meant the sequence could disagree with the shown number.
          -- Rows predating project_number (NULL) fall to the bottom.
          ORDER BY p.project_number IS NULL, p.project_number DESC, p.created_at DESC`,
    args: [],
  });
  projects = projectsResult.rows as any[];

  const sitesResult = await db.execute('SELECT id, site_name, institution FROM site_details ORDER BY site_name');
  sites = sitesResult.rows as any[];

  const statusResult = await db.execute(
    'SELECT project_id, site_id, has_run, not_applicable, na_reason FROM project_run_sites WHERE has_run = 1 OR not_applicable = 1',
  );
  for (const row of statusResult.rows as any[]) {
    const pid = row.project_id as string;
    if (Number(row.has_run) === 1) {
      if (!runMap[pid]) runMap[pid] = new Set();
      runMap[pid].add(row.site_id as string);
    } else {
      if (!naMap[pid]) naMap[pid] = new Map();
      naMap[pid].set(row.site_id as string, (row.na_reason as string | null) || '');
    }
  }

  if (isAdmin) {
    editableSiteIds = new Set(sites.map((s) => s.id as string));
  } else {
    const editorResult = await db.execute({
      sql: 'SELECT site_id FROM site_editors WHERE user_id = ?',
      args: [user.id],
    });
    editableSiteIds = new Set((editorResult.rows as any[]).map((r) => r.site_id as string));
  }
} catch (e: any) {
  error = e.message;
}

function canManage(p: any): boolean {
  return isAdmin || p.created_by === user.id;
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString();
}

// Deadlines are stored as plain YYYY-MM-DD; parse as local time to avoid UTC off-by-one.
function formatDeadline(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString();
}

function isDeadlinePassed(dateStr: string): boolean {
  return new Date(dateStr + 'T23:59:59') < new Date();
}

const PURPOSE_LABELS: Record<string, string> = {
  grant: 'Grant',
  conference: 'Conference / Abstract',
  journal: 'Journal / Manuscript',
  other: 'Exploratory / Other',
};
const PURPOSE_OPTIONS = Object.entries(PURPOSE_LABELS).map(([value, label]) => ({ value, label }));
const CLIF_VERSIONS = PROJECT_RUN_VERSIONS;

// required_tables is a JSON array of table names (NULL on runs that predate it).
function parseTables(value: unknown): string[] {
  if (typeof value !== 'string') return [];
  try {
    const arr = JSON.parse(value);
    return Array.isArray(arr) ? arr.filter((t) => typeof t === 'string') : [];
  } catch {
    return [];
  }
}
// Earliest deadline a new or reopened run may have (the server enforces it too).
const today = todayInConsortiumTz();
---

<BaseLayout title="Project Run Tracker">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <aside class="lg:w-64 shrink-0">
        <PortalNav currentPath={Astro.url.pathname} isAdmin={isAdmin} />
      </aside>

      <div class="flex-1 min-w-0">
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Project Run Tracker</h1>
          <p class="text-gray-600 dark:text-gray-400 mt-1">
            Request that the consortium run a project, and track which sites have run it.
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
            Anyone can file a request. Each site's checkbox is updated by that site's data editor (or an admin).
            If a project doesn't apply to a site, that site's data editor, the run's requester, or an admin can mark it N/A.
            Runs close automatically once their Box upload deadline has passed.
            A run can be logged as <strong class="font-medium">upcoming</strong> before its repo, Box folder and preliminary results exist; sites can act on it once it's launched.
          </p>
        </div>

        {error && (
          <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 rounded-lg p-4 text-sm mb-6">
            Error: {error}
          </div>
        )}

        {/* Tabs. Every tab but Create filters the same list of run cards. */}
        <div class="mb-6">
          <div class="flex overflow-x-auto border-b border-gray-200 dark:border-neutral-700">
            <button id="tab-create" class="tab-btn shrink-0 whitespace-nowrap px-5 py-3 text-sm font-medium border-b-2 border-clif-burgundy text-clif-burgundy transition-colors">
              Create a Project Run
            </button>
            <button class="tab-btn shrink-0 whitespace-nowrap px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors" data-filter="active" data-empty="No active project runs.">
              Active Runs
            </button>
            <button class="tab-btn shrink-0 whitespace-nowrap px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors" data-filter="ats" data-empty={`No ${CURRENT_ATS} project runs yet.`}>
              Upcoming {CURRENT_ATS}
            </button>
            <button class="tab-btn shrink-0 whitespace-nowrap px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors" data-filter="upcoming" data-empty="No upcoming project runs.">
              All Upcoming
            </button>
            <button class="tab-btn shrink-0 whitespace-nowrap px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors" data-filter="all" data-empty="No project run requests yet.">
              All Projects
            </button>
          </div>
        </div>

        {/* Tab: Create a Project Run */}
        <div id="panel-create" class="tab-panel">
        <div class="bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">New Project Run Request</h2>
          <form id="create-project-form" class="space-y-4">
            {/* Ready now vs upcoming. An upcoming run may skip the repo, Box
                folder and preliminary results until it launches. */}
            <fieldset>
              <legend class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Run status <span class="text-red-500">*</span></legend>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 dark:border-neutral-600 cursor-pointer transition-colors hover:border-clif-burgundy/50 has-[:checked]:border-clif-burgundy has-[:checked]:bg-clif-burgundy/5 dark:has-[:checked]:bg-clif-burgundy/15">
                  <input type="radio" name="pr-kind" value="open" checked class="mt-0.5 w-4 h-4 shrink-0 accent-clif-burgundy" />
                  <span>
                    <span class="block text-sm font-semibold text-gray-900 dark:text-white">Ready</span>
                    <span class="block text-xs text-gray-600 dark:text-gray-400 mt-0.5">Sites can start now. All fields required.</span>
                  </span>
                </label>
                <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 dark:border-neutral-600 cursor-pointer transition-colors hover:border-clif-burgundy/50 has-[:checked]:border-clif-burgundy has-[:checked]:bg-clif-burgundy/5 dark:has-[:checked]:bg-clif-burgundy/15">
                  <input type="radio" name="pr-kind" value="upcoming" class="mt-0.5 w-4 h-4 shrink-0 accent-clif-burgundy" />
                  <span>
                    <span class="block text-sm font-semibold text-gray-900 dark:text-white">Upcoming</span>
                    <span class="block text-xs text-gray-600 dark:text-gray-400 mt-0.5">Planned, not ready yet. Repo, Box and prelim results can wait until launch.</span>
                  </span>
                </label>
              </div>
            </fieldset>
            <fieldset>
              <legend class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Conference</legend>
              <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 dark:border-neutral-600 cursor-pointer transition-colors hover:border-clif-burgundy/50 has-[:checked]:border-clif-burgundy has-[:checked]:bg-clif-burgundy/5 dark:has-[:checked]:bg-clif-burgundy/15">
                <input type="checkbox" id="pr-ats" value={CURRENT_ATS} class="mt-0.5 w-4 h-4 shrink-0 accent-clif-burgundy" />
                <span>
                  <span class="block text-sm font-semibold text-gray-900 dark:text-white">{CURRENT_ATS}</span>
                  <span class="block text-xs text-gray-600 dark:text-gray-400 mt-0.5">Tag this run for {CURRENT_ATS}. It will be listed under the {CURRENT_ATS} tab.</span>
                </span>
              </label>
            </fieldset>
            {/* Prerequisite: preliminary results must be shared before a run can be requested */}
            <div class="rounded-lg border-l-4 border-clif-burgundy bg-clif-burgundy/5 dark:bg-clif-burgundy/10 px-4 py-3 space-y-2">
              <label class="flex items-start gap-2 cursor-pointer">
                <input type="checkbox" id="pr-prelim" required class="ready-required mt-0.5 w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" />
                <span class="text-sm font-medium text-gray-800 dark:text-gray-200">
                  I have shared the preliminary project results <span class="ready-mark text-red-500">*</span> <span class="upcoming-mark hidden text-xs font-normal text-gray-400 dark:text-gray-500">(optional for upcoming)</span>
                  <span class="ready-mark block text-xs font-normal text-gray-500 dark:text-gray-400 mt-0.5">Required — a consortium run can only be requested after preliminary results have been shared.</span>
                  <span class="upcoming-mark hidden block text-xs font-normal text-gray-500 dark:text-gray-400 mt-0.5">Required when you launch the run.</span>
                </span>
              </label>
              <div id="pr-prelim-link-field" class="hidden">
                <label for="pr-prelim-link" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Link to preliminary results <span class="text-red-500">*</span></label>
                <input type="url" id="pr-prelim-link" placeholder="https://..."
                  class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent" />
              </div>
            </div>
            <div>
              <label for="pr-title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Project Title <span class="text-red-500">*</span></label>
              <input type="text" id="pr-title" required placeholder="e.g. Sepsis phenotyping across CLIF sites"
                class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="pr-repo" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Project Repo <span class="ready-mark text-red-500">*</span> <span class="upcoming-mark hidden text-xs font-normal text-gray-400 dark:text-gray-500">(optional for upcoming)</span></label>
                <input type="url" id="pr-repo" required placeholder="https://github.com/..."
                  class="ready-required w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent" />
              </div>
              <div>
                <label for="pr-box" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Box Folder <span class="ready-mark text-red-500">*</span> <span class="upcoming-mark hidden text-xs font-normal text-gray-400 dark:text-gray-500">(optional for upcoming)</span></label>
                <input type="url" id="pr-box" required placeholder="https://uchicago.box.com/..."
                  class="ready-required w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent" />
              </div>
            </div>
            <div>
              <label for="pr-description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Brief description <span class="text-red-500">*</span></label>
              <textarea id="pr-description" rows="2" required placeholder="A one or two sentence summary of the project..."
                class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent"></textarea>
            </div>
            <div>
              <label for="pr-instructions" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Specific instructions <span class="text-red-500">*</span></label>
              <textarea id="pr-instructions" rows="4" required placeholder="Exactly what each site needs to do to run the project (steps, config, what to upload)..."
                class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent"></textarea>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Highlighted on the request so sites can't miss it.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="pr-purpose" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Purpose <span class="text-red-500">*</span></label>
                <select id="pr-purpose" required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent">
                  <option value="" disabled selected>Select a purpose…</option>
                  {PURPOSE_OPTIONS.map((o) => (
                    <option value={o.value}>{o.label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="pr-purpose-detail" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Purpose detail <span class="text-red-500">*</span></label>
                <input type="text" id="pr-purpose-detail" required placeholder="e.g. grant name, conference, or journal"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="pr-deadline" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Deadline to upload results to Box <span class="text-red-500">*</span></label>
                <input type="date" id="pr-deadline" required min={today}
                  class="w-full sm:w-auto px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent" />
              </div>
              <div>
                <label for="pr-clif-version" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">CLIF version <span class="text-red-500">*</span></label>
                <select id="pr-clif-version" required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-clif-burgundy focus:border-transparent">
                  <option value="" disabled selected>Select the CLIF version this runs on…</option>
                  {CLIF_VERSIONS.map((v) => (
                    <option value={v}>CLIF {v}</option>
                  ))}
                </select>
              </div>
            </div>
            <RequiredTablesPicker />
            <div id="pr-notify-row" class="flex items-center gap-2 pt-1">
              <input type="checkbox" id="pr-notify" class="w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" />
              <label for="pr-notify" class="text-sm font-medium text-gray-700 dark:text-gray-300">
                Notify all members that this project run is ready
              </label>
              <span class="text-xs text-gray-400 dark:text-gray-500">(emails every approved member)</span>
            </div>
            <div id="pr-create-error" class="hidden text-sm text-red-600 dark:text-red-400"></div>
            <button type="submit" id="pr-create-btn"
              class="bg-clif-burgundy hover:bg-clif-burgundy/90 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors">
              Submit Request
            </button>
          </form>
        </div>
        </div>

        {/* Run tabs share one panel; JS filters the cards (see showRuns). */}
        <div id="panel-runs" class="tab-panel hidden">
        {projects.length === 0 ? (
          <div class="bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 p-6 text-center text-gray-500 dark:text-gray-400 text-sm">
            No project run requests yet.
          </div>
        ) : (
          <div class="space-y-4">
            <div id="runs-empty-msg" class="hidden bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 p-6 text-center text-gray-500 dark:text-gray-400 text-sm">
            </div>
            {projects.map((p) => {
              const ranSites = runMap[p.id as string] || new Set();
              const ranCount = ranSites.size;
              const naSites = naMap[p.id as string] || new Map();
              const naCount = naSites.size;
              const applicableCount = sites.length - naCount;
              const naSuffix = naCount > 0 ? ` · ${naCount} N/A` : '';
              const requiredTables = parseTables(p.required_tables);
              const status = toProjectRunStatus(p.status);
              const isClosed = status === 'closed';
              const isUpcoming = status === 'upcoming';
              const badge = STATUS_BADGE[status];
              // A run drops out of the Active tab once its deadline is behind
              // it. The nightly /api/project-runs/auto-close job then closes it;
              // this badge covers the hours between the deadline and that run.
              // On an upcoming run it flags that launching needs a new deadline.
              const deadlinePassed =
                !isClosed && !!p.results_deadline && isDeadlinePassed(p.results_deadline as string);
              const manage = canManage(p);
              return (
                <div class="project-card bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700" data-project={p.id} data-status={status} data-conference={p.conference || ''} data-deadline-passed={deadlinePassed ? 'true' : 'false'}>
                  {/* Collapsed by default: the summary carries the number, title,
                      badges and a one-line status. Detail lives in the body. */}
                  <details class="group">
                    <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none p-6 flex items-start gap-3 rounded-xl hover:bg-gray-50 dark:hover:bg-neutral-700/30 transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 mt-1 shrink-0 text-gray-400 dark:text-gray-500 transition-transform group-open:rotate-90" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                      </svg>
                      <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        {p.project_number != null && (
                          <span class="shrink-0 text-base font-semibold text-gray-400 dark:text-gray-500 tabular-nums">{p.project_number}.</span>
                        )}
                        <h3 class="text-base font-semibold text-gray-900 dark:text-white">{p.title}</h3>
                        <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${badge.classes}`}>{badge.label}</span>
                        {p.conference && (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold border border-clif-burgundy/40 text-clif-burgundy dark:border-clif-burgundy/60 dark:text-red-300">{p.conference}</span>
                        )}
                        {deadlinePassed && (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">Deadline passed</span>
                        )}
                        {p.purpose && PURPOSE_LABELS[p.purpose as string] && (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-clif-burgundy/10 text-clif-burgundy dark:bg-clif-burgundy/20">{PURPOSE_LABELS[p.purpose as string]}</span>
                        )}
                        {p.clif_version && (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300">CLIF {p.clif_version}</span>
                        )}
                        {Number(p.prelim_shared) === 1 ? (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">Prelim results shared</span>
                        ) : (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400">Prelim results not shared</span>
                        )}
                      </div>
                      {/* Stays visible while collapsed — enough to scan without opening. */}
                      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        {isUpcoming ? (
                          <span>Not launched yet</span>
                        ) : (
                          <span class="ran-summary">{ranCount} / {applicableCount} sites have run this{naSuffix}</span>
                        )}
                        {p.results_deadline && (
                          <span class={deadlinePassed ? 'text-red-500 dark:text-red-400 font-medium' : ''}>
                            Box upload deadline: {formatDeadline(p.results_deadline as string)}
                            {deadlinePassed && ' (passed)'}
                          </span>
                        )}
                      </div>
                      </div>
                    </summary>

                    <div class="px-6 pb-6">
                      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                        <div class="min-w-0">
                      {p.description && (
                        <p class="text-sm text-gray-600 dark:text-gray-400 whitespace-pre-line">{p.description}</p>
                      )}
                      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs text-gray-500 dark:text-gray-400">
                        <span>By {p.creator_name || 'Unknown'}</span>
                        <span>Requested: {formatDate(p.created_at as string)}</span>
                        {p.purpose_detail && (
                          <span>Purpose: {PURPOSE_LABELS[p.purpose as string] || p.purpose} — {p.purpose_detail}</span>
                        )}
                        {p.repo_url && (
                          <a href={p.repo_url} target="_blank" rel="noopener noreferrer" class="text-clif-burgundy hover:underline">Repo &#8599;</a>
                        )}
                        {p.box_folder_url && (
                          <a href={p.box_folder_url} target="_blank" rel="noopener noreferrer" class="text-clif-burgundy hover:underline">Box folder &#8599;</a>
                        )}
                        {Number(p.prelim_shared) === 1 && p.prelim_link && (
                          <a href={p.prelim_link} target="_blank" rel="noopener noreferrer" class="text-clif-burgundy hover:underline">Preliminary results &#8599;</a>
                        )}
                      </div>
                    </div>

                    {manage && isUpcoming && (
                      <div class="flex items-center gap-3 shrink-0">
                        <button
                          type="button"
                          class="launch-project-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold shadow-sm bg-clif-burgundy text-white hover:bg-clif-burgundy/90 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-clif-burgundy/50"
                          data-project-id={p.id}
                          title="Fill in the remaining details and open this run to sites"
                        >
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
                          </svg>
                          Launch run
                        </button>
                        <span class="w-px h-4 bg-gray-200 dark:bg-neutral-600" aria-hidden="true"></span>
                        <button class="edit-project-btn text-xs text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 underline" data-project-id={p.id}>Edit</button>
                        <button class="status-project-btn text-xs text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 underline" data-project-id={p.id} data-next="closed" title="Close this run without launching it">Close</button>
                        <button class="delete-project-btn text-xs text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 underline" data-project-id={p.id}>Delete</button>
                      </div>
                    )}
                    {manage && !isUpcoming && (
                      <div class="flex items-center gap-3 shrink-0">
                        {/* Close button and its info marker share one hover group, so
                            the explanation appears whenever the pointer is on either.
                            The group is NAMED: the whole card is a <details class="group">,
                            and a bare group-hover: compiles to a descendant selector, so
                            an unnamed group here would fire on hover anywhere in the card. */}
                        <span class="group/runinfo relative inline-flex items-center gap-1.5">
                        <button
                          class={`status-project-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-clif-burgundy/50 ${
                            isClosed
                              ? 'border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 dark:border-neutral-600 dark:text-gray-200 dark:bg-neutral-800 dark:hover:bg-neutral-700'
                              : 'bg-clif-burgundy text-white hover:bg-clif-burgundy/90'
                          }`}
                          data-project-id={p.id}
                          data-next={isClosed ? 'open' : 'closed'}
                        >
                          {isClosed ? (
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                          ) : (
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                          )}
                          {isClosed ? 'Reopen run' : 'Close run'}
                        </button>
                          <button
                            type="button"
                            class="run-info-btn peer inline-flex items-center justify-center w-4 h-4 rounded-full border border-gray-400 text-gray-500 dark:border-gray-500 dark:text-gray-400 text-[10px] leading-none font-semibold hover:border-gray-600 hover:text-gray-700 dark:hover:text-gray-200 focus:outline-none focus:ring-2 focus:ring-clif-burgundy/50"
                            aria-label={isClosed ? 'What reopening does' : 'What closing does'}
                          >i</button>
                          <span
                            role="note"
                            class="pointer-events-none invisible opacity-0 group-hover/runinfo:visible group-hover/runinfo:opacity-100 peer-focus-visible:visible peer-focus-visible:opacity-100 transition-opacity absolute right-0 top-full mt-2 z-20 w-72 rounded-lg bg-gray-900 dark:bg-neutral-700 text-white text-xs leading-relaxed p-3 shadow-lg text-left font-normal normal-case"
                          >
                            {isClosed ? (
                              <>
                                <strong class="block mb-1">Reopening this run</strong>
                                Requests for runs open again — sites can submit new data for this project.
                                Members will see it in their pending tasks again, and sites that still owe a
                                run can be notified about it. You'll be asked for a new Box upload deadline;
                                the run closes again automatically once that deadline passes.
                              </>
                            ) : (
                              <>
                                <strong class="block mb-1">Closing this run</strong>
                                Requests for runs are closed — sites are no longer submitting new data for
                                this project. Members will also stop seeing it in their pending tasks, and
                                will no longer be notified that a run is still pending at their site.
                                Runs also close on their own once their Box upload deadline passes.
                              </>
                            )}
                          </span>
                        </span>
                        <span class="w-px h-4 bg-gray-200 dark:bg-neutral-600" aria-hidden="true"></span>
                        <button class="notify-project-btn text-xs text-clif-burgundy hover:text-clif-burgundy/80 underline" data-project-id={p.id} title="Email all approved members that this run is ready">Notify members</button>
                        <button class="edit-project-btn text-xs text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 underline" data-project-id={p.id}>Edit</button>
                        <button class="delete-project-btn text-xs text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 underline" data-project-id={p.id}>Delete</button>
                      </div>
                    )}
                  </div>

                  {/* Reopen (hidden until "Reopen run" is clicked): a reopened run
                      needs a new deadline of today or later, or the nightly
                      auto-close job would just close it again. */}
                  {manage && isClosed && (
                    <form class="reopen-form hidden mt-3 rounded-lg border border-gray-200 dark:border-neutral-700 bg-gray-50 dark:bg-neutral-900/40 px-4 py-3" data-project-id={p.id}>
                      <div class="flex flex-wrap items-end gap-3">
                        <div>
                          <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">New Box upload deadline <span class="text-red-500">*</span></label>
                          <input type="date" class="reopen-deadline px-3 py-1.5 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" min={today} required />
                        </div>
                        <button type="submit" class="reopen-submit bg-clif-burgundy hover:bg-clif-burgundy/90 text-white font-medium py-1.5 px-3 rounded-lg text-xs transition-colors">Reopen run</button>
                        <button type="button" class="reopen-cancel text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 underline">Cancel</button>
                      </div>
                      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">The run will close again automatically once this deadline passes.</p>
                    </form>
                  )}

                  {/* Specific instructions — highlighted so sites can't miss them */}
                  {p.instructions && (
                    <div class="mt-3 rounded-lg border-l-4 border-clif-burgundy bg-clif-burgundy/5 dark:bg-clif-burgundy/10 px-4 py-3">
                      <p class="text-xs font-semibold uppercase tracking-wide text-clif-burgundy mb-1">Instructions to run</p>
                      <p class="text-sm text-gray-700 dark:text-gray-200 whitespace-pre-line">{p.instructions}</p>
                    </div>
                  )}

                  {/* Tables a site must have to run this project */}
                  {requiredTables.length > 0 && (
                    <div class="mt-3">
                      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1.5">
                        Tables sites need{p.clif_version ? ` (CLIF ${p.clif_version})` : ''}
                      </p>
                      <div class="flex flex-wrap gap-1.5">
                        {requiredTables.map((t) => (
                          <code class="px-1.5 py-0.5 rounded bg-gray-100 dark:bg-neutral-700 text-xs text-gray-700 dark:text-gray-200">{t}</code>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Edit form (hidden) */}
                  {manage && (
                    <form class="project-edit-form hidden mt-4 pt-4 border-t border-gray-100 dark:border-neutral-700 space-y-3" data-project-id={p.id} data-mode="edit" data-upcoming={isUpcoming ? 'true' : 'false'}>
                      {isUpcoming && (
                        <p class="launch-only hidden text-sm text-gray-700 dark:text-gray-300">
                          <strong class="font-semibold">Launch this run.</strong> Every field is required now, including the repo, Box folder and preliminary results, and the Box upload deadline must be today or later.
                        </p>
                      )}
                      <input type="text" class="edit-title w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" value={p.title} placeholder="Title" required />
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <input type="url" class="edit-repo w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" value={p.repo_url || ''} placeholder="Repo URL" required={!isUpcoming} />
                        <input type="url" class="edit-box w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" value={p.box_folder_url || ''} placeholder="Box folder URL" required={!isUpcoming} />
                      </div>
                      <textarea class="edit-description w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" rows="2" placeholder="Brief description" required>{p.description || ''}</textarea>
                      <textarea class="edit-instructions w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" rows="4" placeholder="Specific instructions to run" required>{p.instructions || ''}</textarea>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <select class="edit-purpose w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" required>
                          <option value="" disabled selected={!p.purpose}>Select a purpose…</option>
                          {PURPOSE_OPTIONS.map((o) => (
                            <option value={o.value} selected={p.purpose === o.value}>{o.label}</option>
                          ))}
                        </select>
                        <input type="text" class="edit-purpose-detail w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" value={p.purpose_detail || ''} placeholder="Purpose detail (grant name, conference, journal)" required />
                      </div>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Deadline to upload results to Box</label>
                          <input type="date" class="edit-deadline px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" value={p.results_deadline || ''} required />
                        </div>
                        <div>
                          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">CLIF version</label>
                          <select class="edit-clif-version w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" required>
                            <option value="" disabled selected={!p.clif_version}>Select a CLIF version…</option>
                            {CLIF_VERSIONS.map((v) => (
                              <option value={v} selected={p.clif_version === v}>CLIF {v}</option>
                            ))}
                          </select>
                        </div>
                      </div>
                      <RequiredTablesPicker current={p.clif_version as string | null} selected={requiredTables} />
                      <div class="flex items-center gap-2">
                        <input type="checkbox" class="edit-prelim w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" checked={Number(p.prelim_shared) === 1} />
                        <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Preliminary results shared</label>
                      </div>
                      <input type="url" class="edit-prelim-link w-full px-3 py-2 border border-gray-300 dark:border-neutral-600 rounded-lg text-sm bg-white dark:bg-neutral-700 text-gray-900 dark:text-white" value={p.prelim_link || ''} placeholder="Link to preliminary results" />
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="edit-ats w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" value={p.conference || CURRENT_ATS} checked={!!p.conference} />
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">This run is for {p.conference || CURRENT_ATS}</span>
                      </label>
                      {!isUpcoming && (
                        <div class="flex items-center gap-2">
                          <input type="checkbox" class="edit-closed w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" checked={isClosed} />
                          <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Mark as closed</label>
                        </div>
                      )}
                      {isUpcoming && (
                        <label class="launch-only hidden flex items-center gap-2 cursor-pointer">
                          <input type="checkbox" class="edit-notify w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy" />
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Notify all members that this project run is ready</span>
                          <span class="text-xs text-gray-400 dark:text-gray-500">(emails every approved member)</span>
                        </label>
                      )}
                      <div class="flex gap-2">
                        <button type="submit" class="save-project-btn bg-clif-burgundy hover:bg-clif-burgundy/90 text-white font-medium py-1.5 px-3 rounded-lg text-xs transition-colors">Save</button>
                        <button type="button" class="cancel-edit-btn text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 underline" data-project-id={p.id}>Cancel</button>
                      </div>
                    </form>
                  )}

                  {/* Per-site checklist — only once a run is launched */}
                  {isUpcoming ? (
                    <p class="mt-4 pt-4 border-t border-gray-100 dark:border-neutral-700 text-sm text-gray-500 dark:text-gray-400">
                      Sites can start once this run launches.
                    </p>
                  ) : (
                  <div class="mt-4 pt-4 border-t border-gray-100 dark:border-neutral-700">
                    <div class="flex items-center justify-between mb-3">
                      <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Sites that have run this</h4>
                      <span class="ran-count text-xs text-gray-500 dark:text-gray-400">{ranCount} / {applicableCount} sites{naSuffix}</span>
                    </div>
                    {sites.length === 0 ? (
                      <p class="text-xs text-gray-400 dark:text-gray-500 italic">No sites on record.</p>
                    ) : (
                      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-2">
                        {sites.map((s) => {
                          const checked = ranSites.has(s.id as string);
                          const isNa = naSites.has(s.id as string);
                          const naReason = naSites.get(s.id as string) || '';
                          const editable = !isClosed && editableSiteIds.has(s.id as string);
                          // N/A can also be set by the run's requester, not only
                          // the site's editor. A site that has run it can't be N/A.
                          const canSetNa = !isClosed && (editable || canManage(p));
                          // The creator (or an admin) can nudge a site that hasn't run yet.
                          const canNudge = !isClosed && !checked && canManage(p);
                          return (
                            <div class="site-row flex items-center gap-2 min-w-0" data-na={isNa ? 'true' : 'false'}>
                              <label class={`flex items-center gap-2 text-sm min-w-0 flex-1 ${editable ? 'cursor-pointer text-gray-700 dark:text-gray-300' : 'text-gray-500 dark:text-gray-400'}`}
                                title={editable ? '' : "Only this site's data editor (or an admin) can change this"}>
                                <input
                                  type="checkbox"
                                  autocomplete="off"
                                  class="site-run-checkbox w-4 h-4 text-clif-burgundy border-gray-300 rounded focus:ring-clif-burgundy disabled:opacity-50"
                                  data-project-id={p.id}
                                  data-site-id={s.id}
                                  data-editable={editable ? 'true' : 'false'}
                                  checked={checked}
                                  disabled={!editable || isNa}
                                />
                                <span class="min-w-0">
                                  <span class="flex items-center gap-1.5 min-w-0">
                                    <span class="truncate">{s.site_name}</span>
                                    <span class={`na-badge shrink-0 px-1.5 py-px rounded text-[10px] font-semibold bg-gray-100 text-gray-600 dark:bg-neutral-700 dark:text-gray-300 ${isNa ? '' : 'hidden'}`}>N/A</span>
                                  </span>
                                  <span class={`na-reason block truncate text-[11px] text-gray-400 dark:text-gray-500 ${isNa && naReason ? '' : 'hidden'}`}>{naReason}</span>
                                </span>
                              </label>
                              {canSetNa && (
                                <button
                                  type="button"
                                  class={`na-btn shrink-0 text-[11px] font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:underline ${checked ? 'hidden' : ''}`}
                                  data-project-id={p.id}
                                  data-site-id={s.id}
                                  data-site-name={s.site_name}
                                  title={`Mark whether this project applies to ${s.site_name}`}
                                >{isNa ? 'Undo N/A' : 'Mark N/A'}</button>
                              )}
                              {canNudge && (
                                <button
                                  type="button"
                                  class={`nudge-site-btn shrink-0 text-[11px] font-medium text-clif-burgundy hover:text-clif-burgundy/80 hover:underline ${isNa ? 'hidden' : ''}`}
                                  data-project-id={p.id}
                                  data-site-id={s.id}
                                  data-site-name={s.site_name}
                                  title={`Remind ${s.site_name}'s data editor to run this project`}
                                >Remind</button>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                  )}
                    </div>
                  </details>
                </div>
              );
            })}
          </div>
        )}
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // === Sub-tabs: Create, then run lists filtered by data-filter ===
      var tabCreate = document.getElementById('tab-create');
      var runTabs = Array.prototype.slice.call(document.querySelectorAll('.tab-btn[data-filter]'));
      var panelCreate = document.getElementById('panel-create');
      var panelRuns = document.getElementById('panel-runs');
      var emptyMsg = document.getElementById('runs-empty-msg');
      var atsTag = document.getElementById('pr-ats') ? document.getElementById('pr-ats').value : '';

      function setActiveTab(btn) {
        [tabCreate].concat(runTabs).forEach(function (b) {
          if (!b) return;
          b.classList.remove('border-clif-burgundy', 'text-clif-burgundy');
          b.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
        });
        btn.classList.add('border-clif-burgundy', 'text-clif-burgundy');
        btn.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
      }

      function showCreate() {
        setActiveTab(tabCreate);
        if (panelCreate) panelCreate.classList.remove('hidden');
        if (panelRuns) panelRuns.classList.add('hidden');
      }

      // active:   open and still within its deadline
      // upcoming: logged but not launched
      // ats:      tagged for the current ATS, whatever its status
      // all:      everything
      function matches(card, filter) {
        var status = card.getAttribute('data-status');
        if (filter === 'active') return status === 'open' && card.getAttribute('data-deadline-passed') !== 'true';
        if (filter === 'upcoming') return status === 'upcoming';
        if (filter === 'ats') return !!atsTag && card.getAttribute('data-conference') === atsTag;
        return true;
      }

      function showRuns(btn) {
        var filter = btn.getAttribute('data-filter');
        setActiveTab(btn);
        if (panelCreate) panelCreate.classList.add('hidden');
        if (panelRuns) panelRuns.classList.remove('hidden');
        var visible = 0;
        document.querySelectorAll('.project-card').forEach(function (c) {
          var show = matches(c, filter);
          c.classList.toggle('hidden', !show);
          if (show) visible++;
        });
        if (emptyMsg) {
          emptyMsg.textContent = btn.getAttribute('data-empty') || '';
          emptyMsg.classList.toggle('hidden', visible !== 0);
        }
      }

      if (tabCreate) tabCreate.addEventListener('click', showCreate);
      runTabs.forEach(function (b) {
        b.addEventListener('click', function () { showRuns(b); });
      });

      // === Create form: "Ready" vs "Upcoming" ===
      // Upcoming drops the required flag from the repo, Box folder and
      // preliminary-results fields, and hides the notify option (members are
      // told when the run launches).
      var createForm = document.getElementById('create-project-form');
      function createKind() {
        var r = document.querySelector('input[name="pr-kind"]:checked');
        return r ? r.value : 'open';
      }
      function syncCreateKind() {
        if (!createForm) return;
        var upcoming = createKind() === 'upcoming';
        createForm.querySelectorAll('.ready-required').forEach(function (el) { el.required = !upcoming; });
        createForm.querySelectorAll('.ready-mark').forEach(function (el) { el.classList.toggle('hidden', upcoming); });
        createForm.querySelectorAll('.upcoming-mark').forEach(function (el) { el.classList.toggle('hidden', !upcoming); });
        var link = document.getElementById('pr-prelim-link');
        if (link) link.required = !upcoming && document.getElementById('pr-prelim').checked;
        var notifyRow = document.getElementById('pr-notify-row');
        if (notifyRow) notifyRow.classList.toggle('hidden', upcoming);
        var btn = document.getElementById('pr-create-btn');
        if (btn && !btn.disabled) btn.textContent = upcoming ? 'Save Upcoming Run' : 'Submit Request';
      }
      if (createForm) {
        createForm.querySelectorAll('input[name="pr-kind"]').forEach(function (r) {
          r.addEventListener('change', syncCreateKind);
        });
        syncCreateKind();
      }

      // Ticking an ATS box sets the purpose to Conference / Abstract and the
      // detail to the conference name. Unticking clears them again, unless the
      // requester has since changed them.
      function wireAtsAutofill(box, purpose, detail) {
        if (!box || !purpose || !detail) return;
        box.addEventListener('change', function () {
          if (box.checked) {
            purpose.value = 'conference';
            detail.value = box.value;
          } else if (purpose.value === 'conference' && detail.value.trim() === box.value) {
            purpose.value = '';
            detail.value = '';
          }
        });
      }
      var atsBox = document.getElementById('pr-ats');
      wireAtsAutofill(atsBox, document.getElementById('pr-purpose'), document.getElementById('pr-purpose-detail'));
      document.querySelectorAll('.project-edit-form').forEach(function (f) {
        wireAtsAutofill(f.querySelector('.edit-ats'), f.querySelector('.edit-purpose'), f.querySelector('.edit-purpose-detail'));
      });

      // Toggle preliminary-results link field on the create form. The link is
      // required only when the "results shared" box is checked.
      var prelim = document.getElementById('pr-prelim');
      var prelimField = document.getElementById('pr-prelim-link-field');
      var prelimLink = document.getElementById('pr-prelim-link');
      if (prelim && prelimField && prelimLink) {
        prelim.addEventListener('change', function () {
          prelimField.classList.toggle('hidden', !this.checked);
          prelimLink.required = this.checked && createKind() !== 'upcoming';
          if (!this.checked) prelimLink.value = '';
        });
      }

      // === "Tables sites need" picker (RequiredTablesPicker) ===
      // Show only the checklist for the form's selected CLIF version; only its
      // checked tables are submitted.
      function showTablesFor(root, version) {
        if (!root) return;
        root.querySelectorAll('.tables-picker').forEach(function (g) {
          g.classList.toggle('hidden', g.getAttribute('data-version') !== version);
        });
        var empty = root.querySelector('.tables-picker-empty');
        if (empty) empty.classList.toggle('hidden', !!version);
      }
      function selectedTables(root) {
        if (!root) return [];
        return Array.prototype.map.call(
          root.querySelectorAll('.tables-picker:not(.hidden) .table-cb:checked'),
          function (cb) { return cb.value; }
        );
      }
      function wireTablesPicker(formEl, versionSelect) {
        if (!formEl || !versionSelect) return;
        var root = formEl.querySelector('.tables-picker-root');
        versionSelect.addEventListener('change', function () { showTablesFor(root, this.value); });
        // A browser may restore the select's value on back/forward navigation.
        if (versionSelect.value) showTablesFor(root, versionSelect.value);
      }
      // Each collapsible group: "Select all" / "Clear", and a live "N selected"
      // count in its header so picks stay visible while it is collapsed.
      document.querySelectorAll('.tables-group').forEach(function (group) {
        var boxes = group.querySelectorAll('.table-cb');
        var countEl = group.querySelector('.tables-group-count');
        function refreshCount() {
          var n = 0;
          boxes.forEach(function (cb) { if (cb.checked) n++; });
          if (countEl) countEl.textContent = n > 0 ? n + ' selected' : '';
        }
        function setAll(checked) {
          boxes.forEach(function (cb) { cb.checked = checked; });
          refreshCount();
        }
        boxes.forEach(function (cb) { cb.addEventListener('change', refreshCount); });
        group.querySelector('.tables-group-all').addEventListener('click', function () { setAll(true); });
        group.querySelector('.tables-group-none').addEventListener('click', function () { setAll(false); });
      });

      // Create request
      var form = document.getElementById('create-project-form');
      wireTablesPicker(form, document.getElementById('pr-clif-version'));
      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          var btn = document.getElementById('pr-create-btn');
          var errorEl = document.getElementById('pr-create-error');
          var upcoming = createKind() === 'upcoming';
          btn.disabled = true;
          btn.textContent = upcoming ? 'Saving...' : 'Submitting...';
          errorEl.classList.add('hidden');

          var res = await fetch('/api/project-runs/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: document.getElementById('pr-title').value,
              repo_url: document.getElementById('pr-repo').value,
              box_folder_url: document.getElementById('pr-box').value,
              description: document.getElementById('pr-description').value,
              instructions: document.getElementById('pr-instructions').value,
              purpose: document.getElementById('pr-purpose').value,
              purpose_detail: document.getElementById('pr-purpose-detail').value,
              results_deadline: document.getElementById('pr-deadline').value,
              clif_version: document.getElementById('pr-clif-version').value,
              required_tables: selectedTables(form.querySelector('.tables-picker-root')),
              prelim_shared: document.getElementById('pr-prelim').checked,
              prelim_link: document.getElementById('pr-prelim-link').value,
              notify_all: !upcoming && document.getElementById('pr-notify').checked,
              status: upcoming ? 'upcoming' : 'open',
              conference: atsBox && atsBox.checked ? atsBox.value : '',
            }),
          });

          if (res.ok) {
            window.location.reload();
          } else {
            var data = await res.json();
            errorEl.textContent = data.error || 'Failed to submit request';
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            syncCreateKind();
          }
        });
      }

      // === Edit / Launch ===
      // Both open the card's edit form. Launch mode (upcoming runs only)
      // requires every field, offers to notify members, and posts to /launch.
      function editFormFor(pid) {
        return document.querySelector('.project-edit-form[data-project-id="' + pid + '"]');
      }
      function syncEditRequired(f) {
        var strict = f.getAttribute('data-upcoming') !== 'true' || f.getAttribute('data-mode') === 'launch';
        var cb = f.querySelector('.edit-prelim');
        f.querySelector('.edit-repo').required = strict;
        f.querySelector('.edit-box').required = strict;
        cb.required = strict;
        f.querySelector('.edit-prelim-link').required = cb.checked && strict;
      }
      function openEditForm(pid, mode) {
        var f = editFormFor(pid);
        if (!f) return;
        // Clicking the same button again closes the form.
        if (!f.classList.contains('hidden') && f.getAttribute('data-mode') === mode) {
          f.classList.add('hidden');
          return;
        }
        f.setAttribute('data-mode', mode);
        f.querySelectorAll('.launch-only').forEach(function (el) { el.classList.toggle('hidden', mode !== 'launch'); });
        f.querySelector('.save-project-btn').textContent = mode === 'launch' ? 'Launch run' : 'Save';
        syncEditRequired(f);
        f.classList.remove('hidden');
        if (mode === 'launch') f.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      document.querySelectorAll('.edit-project-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { openEditForm(this.getAttribute('data-project-id'), 'edit'); });
      });
      document.querySelectorAll('.launch-project-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { openEditForm(this.getAttribute('data-project-id'), 'launch'); });
      });
      document.querySelectorAll('.cancel-edit-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var f = editFormFor(this.getAttribute('data-project-id'));
          if (f) f.classList.add('hidden');
        });
      });
      document.querySelectorAll('.project-edit-form').forEach(function (f) {
        f.querySelector('.edit-prelim').addEventListener('change', function () { syncEditRequired(f); });
        syncEditRequired(f);
      });

      // Each edit form's tables picker follows its own CLIF version select.
      document.querySelectorAll('.project-edit-form').forEach(function (f) {
        wireTablesPicker(f, f.querySelector('.edit-clif-version'));
      });

      // Save edits
      document.querySelectorAll('.project-edit-form').forEach(function (f) {
        f.addEventListener('submit', async function (e) {
          e.preventDefault();
          var pid = this.getAttribute('data-project-id');
          var launching = this.getAttribute('data-mode') === 'launch';
          var saveBtn = this.querySelector('.save-project-btn');
          var closedBox = this.querySelector('.edit-closed');
          var atsEdit = this.querySelector('.edit-ats');
          var notifyEdit = this.querySelector('.edit-notify');
          saveBtn.disabled = true;
          saveBtn.textContent = launching ? 'Launching...' : 'Saving...';

          var res = await fetch(launching ? '/api/project-runs/launch' : '/api/project-runs/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              projectId: pid,
              title: this.querySelector('.edit-title').value,
              repo_url: this.querySelector('.edit-repo').value,
              box_folder_url: this.querySelector('.edit-box').value,
              description: this.querySelector('.edit-description').value,
              instructions: this.querySelector('.edit-instructions').value,
              purpose: this.querySelector('.edit-purpose').value,
              purpose_detail: this.querySelector('.edit-purpose-detail').value,
              results_deadline: this.querySelector('.edit-deadline').value,
              clif_version: this.querySelector('.edit-clif-version').value,
              required_tables: selectedTables(this.querySelector('.tables-picker-root')),
              prelim_shared: this.querySelector('.edit-prelim').checked,
              prelim_link: this.querySelector('.edit-prelim-link').value,
              status: closedBox && closedBox.checked ? 'closed' : 'open',
              conference: atsEdit && atsEdit.checked ? atsEdit.value : '',
              notify_all: launching && !!notifyEdit && notifyEdit.checked,
            }),
          });

          if (res.ok) {
            window.location.reload();
          } else {
            var data = await res.json();
            alert(data.error || (launching ? 'Failed to launch' : 'Failed to save'));
            saveBtn.disabled = false;
            saveBtn.textContent = launching ? 'Launch run' : 'Save';
          }
        });
      });

      // Notify all members
      document.querySelectorAll('.notify-project-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var pid = this.getAttribute('data-project-id');
          if (!confirm('Email all approved members that this project run is ready?')) return;
          var self = this;
          var original = self.textContent;
          self.disabled = true;
          self.textContent = 'Sending...';
          var res = await fetch('/api/project-runs/notify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId: pid }),
          });
          if (res.ok) {
            var data = await res.json();
            alert('Notification sent to ' + data.sent + ' member' + (data.sent === 1 ? '' : 's') + '.');
          } else {
            var err = await res.json().catch(function () { return {}; });
            alert(err.error || 'Failed to send notifications.');
          }
          self.textContent = original;
          self.disabled = false;
        });
      });

      // Close / reopen
      document.querySelectorAll('.status-project-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var pid = this.getAttribute('data-project-id');
          var next = this.getAttribute('data-next');
          // Reopening goes through the inline form, which asks for a new deadline.
          if (next === 'open') {
            var rf = document.querySelector('.reopen-form[data-project-id="' + pid + '"]');
            if (rf) {
              rf.classList.toggle('hidden');
              if (!rf.classList.contains('hidden')) rf.querySelector('.reopen-deadline').focus();
            }
            return;
          }
          if (!confirm('Close this project run?\n\nRequests for runs will be closed — sites can no longer submit new data for this project. Members will stop seeing it in their pending tasks and will no longer be notified that a run is pending at their site.')) return;
          var self = this;
          var original = self.textContent;
          self.disabled = true;
          self.textContent = next === 'closed' ? 'Closing...' : 'Reopening...';
          var res = await fetch('/api/project-runs/set-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId: pid, status: next }),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            var err = await res.json().catch(function () { return {}; });
            alert(err.error || 'Failed to update status.');
            self.textContent = original;
            self.disabled = false;
          }
        });
      });

      // Reopen with a new deadline
      document.querySelectorAll('.reopen-form').forEach(function (f) {
        f.querySelector('.reopen-cancel').addEventListener('click', function () {
          f.classList.add('hidden');
        });
        f.addEventListener('submit', async function (e) {
          e.preventDefault();
          var btn = f.querySelector('.reopen-submit');
          btn.disabled = true;
          btn.textContent = 'Reopening...';
          var res = await fetch('/api/project-runs/set-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              projectId: f.getAttribute('data-project-id'),
              status: 'open',
              results_deadline: f.querySelector('.reopen-deadline').value,
            }),
          });
          if (res.ok) {
            window.location.reload();
            return;
          }
          var err = await res.json().catch(function () { return {}; });
          alert(err.error || 'Failed to reopen.');
          btn.disabled = false;
          btn.textContent = 'Reopen run';
        });
      });

      // Delete
      document.querySelectorAll('.delete-project-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var pid = this.getAttribute('data-project-id');
          if (!confirm('Delete this project run request? This cannot be undone.')) return;
          var res = await fetch('/api/project-runs/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId: pid }),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete request');
          }
        });
      });

      // Recompute the "N / M sites" counters for a card from its checkboxes.
      // Lets a site toggle update in place instead of reloading — a reload
      // would bounce the user back to the default Create tab and re-collapse
      // every card.
      // N/A sites leave the denominator and are listed separately.
      function refreshRanCounts(card) {
        if (!card) return;
        var total = 0;
        var count = 0;
        var na = 0;
        card.querySelectorAll('.site-row').forEach(function (row) {
          if (row.getAttribute('data-na') === 'true') { na++; return; }
          total++;
          var b = row.querySelector('.site-run-checkbox');
          if (b && b.checked) count++;
        });
        var suffix = na > 0 ? ' · ' + na + ' N/A' : '';
        var summary = card.querySelector('.ran-summary');
        if (summary) summary.textContent = count + ' / ' + total + ' sites have run this' + suffix;
        var header = card.querySelector('.ran-count');
        if (header) header.textContent = count + ' / ' + total + ' sites' + suffix;
      }

      // Per-site run checkboxes
      document.querySelectorAll('.site-run-checkbox').forEach(function (box) {
        box.addEventListener('change', async function () {
          var self = this;
          self.disabled = true;
          var res = await fetch('/api/project-runs/toggle-site', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              projectId: self.getAttribute('data-project-id'),
              siteId: self.getAttribute('data-site-id'),
              hasRun: self.checked,
            }),
          });
          if (res.ok) {
            self.disabled = false;
            // A site that has run the project can't also be N/A.
            var naBtn = self.closest('.site-row').querySelector('.na-btn');
            if (naBtn) naBtn.classList.toggle('hidden', self.checked);
            refreshRanCounts(self.closest('.project-card'));
          } else {
            var data = await res.json();
            alert(data.error || 'Failed to update');
            self.checked = !self.checked;
            self.disabled = false;
          }
        });
      });

      // "Mark N/A" / "Undo N/A" — the project doesn't apply to this site. Updated
      // in place (no reload) for the same reason as the checkboxes above.
      document.querySelectorAll('.na-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var self = this;
          var row = self.closest('.site-row');
          var siteName = self.getAttribute('data-site-name') || 'this site';
          var makeNa = row.getAttribute('data-na') !== 'true';
          var reason = '';
          if (makeNa) {
            reason = prompt(
              'Mark ' + siteName + ' as N/A for this run? It will no longer count as owing it.\n\n' +
              "Optional: why doesn't this project apply to " + siteName + '?',
              ''
            );
            if (reason === null) return;
          } else if (!confirm('Undo N/A for ' + siteName + '? It will count as owing this run again.')) {
            return;
          }
          self.disabled = true;
          try {
            var res = await fetch('/api/project-runs/set-site-na', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                projectId: self.getAttribute('data-project-id'),
                siteId: self.getAttribute('data-site-id'),
                notApplicable: makeNa,
                reason: reason,
              }),
            });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok) {
              alert(data.error || 'Failed to update');
              return;
            }
            row.setAttribute('data-na', makeNa ? 'true' : 'false');
            var box = row.querySelector('.site-run-checkbox');
            if (box) {
              if (makeNa) box.checked = false;
              box.disabled = makeNa || box.getAttribute('data-editable') !== 'true';
            }
            row.querySelector('.na-badge').classList.toggle('hidden', !makeNa);
            var reasonEl = row.querySelector('.na-reason');
            reasonEl.textContent = (makeNa && data.reason) || '';
            reasonEl.classList.toggle('hidden', !(makeNa && data.reason));
            var remind = row.querySelector('.nudge-site-btn');
            if (remind) remind.classList.toggle('hidden', makeNa);
            self.textContent = makeNa ? 'Undo N/A' : 'Mark N/A';
            refreshRanCounts(row.closest('.project-card'));
          } catch (e) {
            alert('Failed to update');
          } finally {
            self.disabled = false;
          }
        });
      });

      // "Remind" — nudge a site's data editor(s) to run this project.
      document.querySelectorAll('.nudge-site-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var self = this;
          var siteName = self.getAttribute('data-site-name') || 'this site';
          if (!confirm('Send a reminder to ' + siteName + "'s data editor to run this project?")) return;
          var original = self.textContent;
          self.disabled = true;
          self.textContent = 'Sending…';
          try {
            var res = await fetch('/api/project-runs/nudge', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                projectId: self.getAttribute('data-project-id'),
                siteId: self.getAttribute('data-site-id'),
              }),
            });
            var data = await res.json();
            if (res.ok) {
              self.textContent = 'Reminded ✓';
              self.classList.add('text-green-600');
            } else {
              alert(data.error || 'Failed to send reminder');
              self.textContent = original;
              self.disabled = false;
            }
          } catch (e) {
            alert('Failed to send reminder');
            self.textContent = original;
            self.disabled = false;
          }
        });
      });
    });
  </script>
</BaseLayout>
