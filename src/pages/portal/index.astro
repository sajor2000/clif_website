---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalNav from '../../components/portal/PortalNav.astro';
import PendingTasks from '../../components/portal/PendingTasks.astro';
import { portalGroups } from '../../data/portal-nav';

const profile = Astro.locals.user;
---

<BaseLayout title="Members Portal">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar -->
      <aside class="lg:w-64 shrink-0">
        <PortalNav currentPath={Astro.url.pathname} isAdmin={profile?.role === 'admin'} />
      </aside>

      <!-- Main Content -->
      <div class="flex-1 min-w-0">
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
            Welcome{profile?.full_name ? `, ${profile.full_name}` : ''}
          </h1>
          <p class="text-gray-600 dark:text-gray-400 mt-2">Access consortium data and resources</p>
        </div>

        {profile?.id && <PendingTasks userId={profile.id} role={profile.role} />}

        <div class="space-y-8">
          {portalGroups.map((group) => (
            <section>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
                {group.title}
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class="group bg-white dark:bg-neutral-800 rounded-xl shadow-sm border border-gray-200 dark:border-neutral-700 p-6 hover:shadow-md hover:border-clif-burgundy/30 transition-all"
                  >
                    <h3 class="flex items-center gap-2 text-lg font-semibold text-gray-900 dark:text-white group-hover:text-clif-burgundy transition-colors">
                      {item.label}
                      {item.wip && (
                        <span class="text-[10px] font-semibold uppercase tracking-wide bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 px-1.5 py-0.5 rounded">WIP</span>
                      )}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                      {item.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
