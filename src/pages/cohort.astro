---
export const prerender = true;
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import CohortSummaryFromCSV from '../components/cohort/CohortSummaryFromCSV.astro';
import InteractiveDashboard from '../components/cohort/InteractiveDashboard.astro';
import HourlyTrends from '../components/cohort/HourlyTrends.astro';
import DataDistributions from '../components/cohort/DataDistributions.astro';
import MapExplorer from '../components/cohort/MapExplorer.astro';
import CTAButton from '../components/shared/CTAButton.astro';
import { COHORTS, VISIBLE_COHORTS, VISIBLE_GROUPS, SUBCOHORTS, PANEL_COHORTS, DEFAULT_COHORT, AGGREGATE_SITE, SITE_LABELS, SITE_ORDER, getCohort, parseCohortCSV, getAggregateValue, contributingSitesForCohort } from '../utils/cohortData';

// Labels for the level-1 group buttons. Only groups that still have a visible
// cohort are rendered, so hiding every cohort in a group removes its button.
const GROUP_LABELS: Record<string, string> = {
  overall: 'Other',
  critically_ill: 'Critically ill',
};

// Build per-cohort headline numbers (unique patients / encounter blocks / hospitals)
// for the hero + picker. Read the cohort's summary source at build time.
// Sub-cohorts (advanced_resp/vaso splits) reuse the parent's CohortDef but read
// their own Overall-shaped table_one and inherit the parent's tab availability.
const cohortDir = path.join(process.cwd(), 'src', 'data', 'cohorts');
function headlineFor(key: string) {
  const sub = SUBCOHORTS.find((s) => s.key === key);
  const def = getCohort(sub ? sub.parent : key);
  const file = !sub && def.hasOverallFile ? 'table_one_overall.csv' : 'table_one_by_year.csv';
  const csv = fs.readFileSync(path.join(cohortDir, key, file), 'utf-8');
  const data = parseCohortCSV(csv);
  const num = (v: string | null) => (v ? v.replace(/^"|"$/g, '').replace(/\s*\(.*$/, '').trim() : '—');
  return {
    key,
    label: sub ? `${def.label} — ${sub.label}` : def.label,
    group: sub ? 'critically_ill' : def.group,
    hasHourly: def.hasHourly,
    // Derived from disk rather than declared, so it cannot drift from what the
    // Distributions tab can actually load. Sub-cohorts have no ECDF folder of
    // their own and fall back to the parent, matching DataDistributions.
    // The ward cohort has none at all: the upstream ward pipeline
    // (run_tableone_ward.py) emits table_one only — no bins, and no entry in
    // the ECDF generator's STRATUM_WINDOW_TYPE map.
    hasDistributions: fs.existsSync(
      path.join(process.cwd(), 'src', 'data', 'cohort_ecdf', sub ? sub.parent : key)
    ),
    patients: num(getAggregateValue(data, 'N: Unique patients')),
    encounters: num(getAggregateValue(data, 'N: Encounter blocks')),
    hospitals: num(getAggregateValue(data, 'N: Hospitals')),
    // Hero wording travels with the numbers so the sentence and the figures in
    // it can never describe different cohorts. Every critically-ill stratum is
    // a subset of that union, so they all inherit the default noun.
    noun: def.noun ?? 'critically ill patients',
    // Same source as the Sites tile in CohortSummaryFromCSV, so the count in
    // the prose cannot drift from the count in the rail. Resolved here rather
    // than on the client: the token is a build-time concern.
    description: (def.description ?? '').replace(
      '{sites}',
      String(contributingSitesForCohort(sub ? sub.parent : key).length)
    ),
    // Gates the "What are Critically Ill Patients?" modal trigger — that
    // definition does not describe the ward cohort.
    isCriticallyIll: (sub ? 'critically_ill' : def.group) === 'critically_ill',
  };
}
const cohortHeadlines = Object.fromEntries(PANEL_COHORTS.map((k) => [k, headlineFor(k)]));
// First paint only. The hero follows the cohort bus from here on (see the
// subscriber below) — it has to, because the ward cohort is a different and
// larger population than the default, drawn from fewer sites, so a fixed
// sentence would contradict the tiles beside it.
const heroStats = cohortHeadlines[DEFAULT_COHORT];
// Meta description derives from the same headline numbers as the hero so it
// can never drift from what the page shows at the next data refresh.
const metaDescription =
  `Explore aggregated critically ill patient data from the CLIF Consortium - ` +
  `${heroStats.patients} unique patients, ${heroStats.encounters} hospitalizations across ` +
  `${heroStats.hospitals} hospitals in ${SITE_ORDER.filter((s) => s !== AGGREGATE_SITE).length} participating institutions.`;
// Sub-group options per parent for the 3rd-level picker (data for the client).
const subsByParent = Object.fromEntries(
  VISIBLE_COHORTS.filter((c) => SUBCOHORTS.some((s) => s.parent === c.key)).map((c) => [
    c.key,
    SUBCOHORTS.filter((s) => s.parent === c.key).map((s) => ({ key: s.key, label: s.label })),
  ])
);
---

<BaseLayout
  title="CLIF Consortium - Cohort Dashboard"
  description={metaDescription}
>
  <!-- Chart.js CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" integrity="sha384-9nhczxUqK87bcKHh20fSQcTGD4qq5GhayNYSYWqwBkINBhOfQLg/P5HG5lF1urn4" crossorigin="anonymous"></script>
  <!-- Chart.js Datalabels Plugin -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js" integrity="sha384-y49Zu59jZHJL/PLKgZPv3k2WI9c0Yp3pWB76V8OBVCb0QBKS8l4Ff3YslzHVX76Y" crossorigin="anonymous"></script>
  <!-- Register Datalabels Plugin -->
  <script is:inline>
    if (typeof Chart !== 'undefined' && typeof ChartDataLabels !== 'undefined') {
      Chart.register(ChartDataLabels);
    }

    // Set Chart.js colors based on current theme
    function applyChartTheme() {
      if (typeof Chart === 'undefined') return;
      var isDark = document.documentElement.classList.contains('dark');
      Chart.defaults.color = isDark ? '#a3a3a3' : '#666666';
      Chart.defaults.borderColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
      // Update all existing chart instances
      Object.values(Chart.instances || {}).forEach(function(chart) {
        chart.options.scales && Object.values(chart.options.scales).forEach(function(scale) {
          if (scale.title) scale.title.color = isDark ? '#d4d4d4' : '#666666';
          if (scale.ticks) scale.ticks.color = isDark ? '#a3a3a3' : '#666666';
          if (scale.grid) scale.grid.color = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.1)';
        });
        if (chart.options.plugins && chart.options.plugins.legend && chart.options.plugins.legend.labels) {
          chart.options.plugins.legend.labels.color = isDark ? '#d4d4d4' : '#666666';
        }
        chart.update('none');
      });
    }

    applyChartTheme();

    // Listen for theme toggles
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.attributeName === 'class') applyChartTheme();
      });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  </script>

  <!-- D3 (used by the cohort summary charts) -->
  {/* Pinned on jsDelivr rather than d3js.org/d3.v7.min.js: SRI needs an
      immutable target (v7 is a moving alias), and it saves a third origin. */}
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js" integrity="sha384-CjloA8y00+1SDAUkjs099PVfnY2KmDC2BZnws9kh8D/lX1s46w6EPhpXdqMfjK6i" crossorigin="anonymous"></script>

  <!-- Leaflet CSS and JS for Map -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <div class="min-h-screen bg-gradient-to-b from-gray-50 to-white">
    {/* Trying the production cohort page's width (max-w-7xl = 1280px) for the
        cleaner centered look; swap back to max-w-[1800px] to go wide again. */}
    <div class="mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">
      <!-- Enhanced Hero Section -->
      <div class="relative text-center mb-12 animate-fade-in">
        {/* Freshness + schema metadata as a corner chip: costs no vertical
            space. Hidden on small screens where it would collide with the h1. */}
        <div class="absolute top-0 right-0 hidden md:flex items-center gap-4 text-xs text-gray-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Last updated: August 2026
          </span>
          <a
            href="/data-dictionary/data-dictionary-2.1.0"
            class="flex items-center gap-1.5 hover:text-clif-burgundy transition-colors"
            title="View the CLIF 2.1.0 data dictionary"
          >
            <svg class="w-3.5 h-3.5 text-clif-burgundy" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 2c-4.418 0-8 1.343-8 3s3.582 3 8 3 8-1.343 8-3-3.582-3-8-3z"/>
              <path d="M2 7.5V10c0 1.657 3.582 3 8 3s8-1.343 8-3V7.5c-1.73 1.13-4.72 1.75-8 1.75S3.73 8.63 2 7.5z"/>
              <path d="M2 12.5V15c0 1.657 3.582 3 8 3s8-1.343 8-3v-2.5c-1.73 1.13-4.72 1.75-8 1.75s-6.27-.62-8-1.75z"/>
            </svg>
            Built on CLIF v2.1
          </a>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-clif-burgundy mb-4 bg-clip-text text-transparent bg-gradient-to-r from-clif-burgundy to-clif-burgundy-dark">
          CLIF Cohort Dashboard
        </h1>
        {/* whitespace-nowrap + no max-width: the sentence is short enough to own
            one line at desktop widths; it re-wraps naturally on small screens. */}
        <p class="text-lg md:text-xl text-gray-600 mx-auto mb-6 md:whitespace-nowrap">
          Insights from <span id="hero-patients" class="font-semibold text-clif-burgundy">{heroStats.patients}</span> unique
          {/* The definition lives on the hero's own "critically ill" wording; the
              trigger is a sibling of the phrase so the underline stops at the text. */}
          <span
            id="hero-cohort-label"
            class="text-blue-600 hover:text-blue-800 underline decoration-dotted underline-offset-2 cursor-help"
          >critically ill patients</span><button
            id="critically-ill-trigger"
            type="button"
            class="text-blue-600 hover:text-blue-800 align-middle ml-0.5 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500/40"
            aria-label="How is “critically ill” defined?"
            title="How is “critically ill” defined?"
          ><svg class="w-4 h-4 inline-block" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"
            ><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg
          ></button>
          across <span id="hero-encounters" class="font-semibold text-clif-burgundy">{heroStats.encounters}</span> hospitalizations
          from <span id="hero-hospitals" class="font-semibold text-clif-burgundy">{heroStats.hospitals}</span> hospitals
        </p>
        {/* Scope note for cohorts whose coverage differs from the default in a
            way the numbers alone do not explain. Filled by the cohort bus and
            hidden when the selected cohort declares no description. */}
        <p
          id="hero-cohort-note"
          class:list={['text-sm text-gray-500 mx-auto mb-6 max-w-3xl', !heroStats.description && 'hidden']}
        >{heroStats.description}</p>
      </div>

      <!-- Per-cohort headline data + cohort event bus -->
      {/* Site display names + column order for the inline chart/table scripts.
          Site CODES stay the data keys; these are labels only. */}
      <script is:inline set:html={`window.__SITE_LABELS__ = ${JSON.stringify(SITE_LABELS)}; window.__SITE_ORDER__ = ${JSON.stringify(SITE_ORDER)}; window.siteLabel = function (c) { return (window.__SITE_LABELS__ || {})[c] || c; }; window.compareSites = function (a, b) { var o = window.__SITE_ORDER__ || [], ia = o.indexOf(a), ib = o.indexOf(b); if (ia === -1 && ib === -1) return String(a).localeCompare(String(b)); if (ia === -1) return 1; if (ib === -1) return -1; return ia - ib; };`}></script>
      <script is:inline set:html={`window.__COHORT_HEADLINES__ = ${JSON.stringify(cohortHeadlines)}; window.__DEFAULT_COHORT__ = ${JSON.stringify(DEFAULT_COHORT)}; window.__SUBS_BY_PARENT__ = ${JSON.stringify(subsByParent)};`}></script>
      <script is:inline>
        (function () {
          const H = window.__COHORT_HEADLINES__ || {};
          window.CohortBus = {
            current: window.__DEFAULT_COHORT__ || 'overall',
            _subs: [],
            headline: function (key) { return H[key] || {}; },
            subscribe: function (fn) { this._subs.push(fn); try { fn(this.current); } catch (e) {} },
            set: function (key) {
              if (!H[key] || key === this.current) { this.current = key; }
              this.current = key;
              this._subs.forEach(function (fn) { try { fn(key); } catch (e) {} });
            },
          };
        })();
      </script>

      {/* Shown when a chart/map library failed to arrive from its CDN, so a
          visitor on a blocking network sees an explanation instead of blank
          boxes. Checked on window load, when all script fetches have settled. */}
      <div id="cdn-fallback-note" class="hidden bg-amber-50 border-l-4 border-amber-400 p-3 rounded mb-8">
        <p class="text-sm font-semibold text-amber-800">Some interactive charts could not be loaded.</p>
        <p class="text-sm text-amber-800 mt-1">
          Your network may be blocking the content delivery services this page uses
          (cdn.jsdelivr.net, unpkg.com). The data tables still work without them.
        </p>
      </div>
      <script is:inline>
        window.addEventListener('load', function () {
          if (typeof Chart === 'undefined' || typeof d3 === 'undefined' || typeof L === 'undefined') {
            document.getElementById('cdn-fallback-note')?.classList.remove('hidden');
          }
        });
      </script>

      <!-- Tabbed Dashboard Section -->
      <section class="mb-16">
        <!-- Tab Navigation (cohort picker rides in the same band, left of the
             tabs: burgundy-tinted so it reads as a control, not another tab,
             and global so every tab keeps access to it) -->
        <div class="flex justify-center mb-8">
          <div class="inline-flex items-stretch bg-gray-100 rounded-lg p-1 shadow-sm overflow-x-auto">
            {/* One dropdown for every cohort. Overall used to be a separate
                level-1 button; it is an option here instead. The optgroups keep
                the distinction that button carried — Overall is all
                hospitalizations, the rest are critically ill — without spending
                a second control on it. */}
            <span id="cohort-type-wrap">
              <select
                id="cohort-type-select"
                aria-label="Cohort"
                class="h-full cursor-pointer border-0 rounded-md px-3 py-3 text-xs md:text-base font-semibold bg-clif-burgundy/10 text-clif-burgundy focus:outline-none focus:ring-2 focus:ring-clif-burgundy/40"
              >
                {VISIBLE_GROUPS.length > 1
                  ? VISIBLE_GROUPS.map((g) => (
                      <optgroup label={GROUP_LABELS[g]}>
                        {VISIBLE_COHORTS.filter((c) => c.group === g).map((c) => (
                          <option value={c.key} selected={c.key === DEFAULT_COHORT}>{c.label}</option>
                        ))}
                      </optgroup>
                    ))
                  : VISIBLE_COHORTS.map((c) => <option value={c.key} selected={c.key === DEFAULT_COHORT}>{c.label}</option>)}
              </select>
            </span>
            <span id="cohort-sub-wrap" class="hidden">
              <select
                id="cohort-sub-select"
                aria-label="Sub-cohort"
                class="h-full cursor-pointer border-0 rounded-md px-3 py-3 text-xs md:text-base font-semibold bg-clif-burgundy/10 text-clif-burgundy focus:outline-none focus:ring-2 focus:ring-clif-burgundy/40 ml-1"
              >
                <!-- populated by JS based on the selected type -->
              </select>
            </span>
            <div class="w-px self-stretch bg-gray-300 mx-2 my-1"></div>
            <button
              id="tab-summary"
              class="px-4 py-3 text-xs md:text-base font-semibold rounded-md transition-all duration-200 bg-clif-burgundy text-white shadow-md whitespace-nowrap"
            >
              Summary Statistics
            </button>
            <button
              id="tab-explorer"
              class="px-4 py-3 text-xs md:text-base font-semibold rounded-md transition-all duration-200 text-gray-700 hover:text-gray-900 whitespace-nowrap"
            >
              Data Explorer
            </button>
            <button
              id="tab-hourly"
              class="px-4 py-3 text-xs md:text-base font-semibold rounded-md transition-all duration-200 text-gray-700 hover:text-gray-900 whitespace-nowrap"
            >
              Hourly Trends
            </button>
            <button
              id="tab-distributions"
              class="px-4 py-3 text-xs md:text-base font-semibold rounded-md transition-all duration-200 text-gray-700 hover:text-gray-900 whitespace-nowrap"
            >
              Data Distributions
            </button>
            <button
              id="tab-map"
              class="px-4 py-3 text-xs md:text-base font-semibold rounded-md transition-all duration-200 text-gray-700 hover:text-gray-900 whitespace-nowrap"
            >
              Map Explorer
            </button>
          </div>
        </div>

        <!-- Tab Content: Summary Statistics -->
        <div id="content-summary" class="tab-content">
          {PANEL_COHORTS.map((k) => <CohortSummaryFromCSV cohort={k} />)}
        </div>

        <!-- Tab Content: Interactive Data Explorer -->
        <div id="content-explorer" class="tab-content hidden">
          <InteractiveDashboard />
        </div>

        <!-- Tab Content: Hourly Trends -->
        <div id="content-hourly" class="tab-content hidden">
          <HourlyTrends />
        </div>

        <!-- Tab Content: Data Distributions -->
        <div id="content-distributions" class="tab-content hidden">
          <DataDistributions />
        </div>

        <!-- Tab Content: Map Explorer -->
        <div id="content-map" class="tab-content hidden">
          <MapExplorer />
        </div>
      </section>

      <!-- Data Source & Methodology Section -->
      <section class="mb-16">
        <div class="max-w-4xl mx-auto space-y-4">
          <!-- Data Source Info Box -->
          <div class="bg-gray-50 border-l-4 border-gray-400 rounded-lg p-6 shadow-sm">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-gray-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
              </svg>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-3">Data Source</h3>
                <p class="text-gray-700 text-sm">
                  This dashboard presents aggregated, de-identified data from the CLIF Consortium spanning 2011-2026. All data has been standardized according to CLIF data format specifications and undergoes rigorous quality assurance processes. <a href="https://github.com/Common-Longitudinal-ICU-data-Format/CLIF-MIMIC" target="_blank" rel="noopener noreferrer" class="text-clif-burgundy hover:underline font-medium">MIMIC IV data</a> is included for benchmarking purposes.
                </p>
              </div>
            </div>
          </div>

          <!-- Methodology Note -->
          <div class="bg-amber-50 border-l-4 border-amber-400 rounded-lg p-4 shadow-sm">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
              </svg>
              <p class="text-amber-800 text-sm">
                <strong>Methodology:</strong> Median values shown are weighted medians calculated using site-specific sample sizes. Interquartile ranges (IQR) represent the minimum Q1 to maximum Q3 observed across sites as an approximation for aggregated data.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Enhanced Call to Action -->
      <section class="relative overflow-hidden rounded-3xl">
        <div class="absolute inset-0 bg-gradient-to-br from-clif-burgundy via-clif-burgundy-dark to-clif-burgundy-darker opacity-90"></div>
        <div class="relative text-center text-white p-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Explore CLIF Research</h2>
          <p class="text-lg md:text-xl mb-8 opacity-90 max-w-3xl mx-auto">
            This dashboard presents real, aggregated data from our consortium. Discover how CLIF enables 
            collaborative research while preserving patient privacy through federated analytics.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <CTAButton
              href="/tools"
              variant="outline"
              class="bg-white text-clif-burgundy hover:bg-gray-100 border-white transform hover:scale-105 transition-all duration-200"
              ariaLabel="Learn about CLIF tools and data access"
            >
              Explore CLIF Tools
            </CTAButton>
            <CTAButton
              href="/research"
              variant="outline"
              class="bg-transparent text-white hover:bg-white/20 border-white transform hover:scale-105 transition-all duration-200"
              ariaLabel="View current research projects using CLIF data"
            >
              View Research Projects
            </CTAButton>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- Critically Ill Modal -->
  <div id="critically-ill-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <!-- Backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <!-- Modal Card -->
    <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full p-6 transform transition-all">
      <button id="modal-close" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900">What are Critically Ill Patients?</h3>
      </div>
      <p class="text-gray-600 mb-4">Our cohort includes patients meeting any of the following criteria:</p>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-gray-700"><strong class="text-gray-900">ICU encounters:</strong> Patients admitted to an ICU</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-gray-700"><strong class="text-gray-900">Advanced respiratory support:</strong> Invasive mechanical ventilation, NIPPV (BiPAP), CPAP, or high-flow nasal cannula at &ge;30 L/min</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-gray-700"><strong class="text-gray-900">Vasopressor support:</strong> Continuous vasopressor infusion (norepinephrine, epinephrine, phenylephrine, vasopressin, dopamine, or angiotensin II)</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-gray-700"><strong class="text-gray-900">Other critically ill:</strong> ED & Ward deaths without ICU stay</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Tab Switching Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Generic tab controller: one active tab at a time.
      const TABS = ['summary', 'explorer', 'hourly', 'distributions', 'map'];
      function activateTab(name) {
        TABS.forEach((t) => {
          const btn = document.getElementById('tab-' + t);
          const content = document.getElementById('content-' + t);
          const on = t === name;
          if (btn) {
            btn.classList.toggle('bg-clif-burgundy', on);
            btn.classList.toggle('text-white', on);
            btn.classList.toggle('shadow-md', on);
            btn.classList.toggle('text-gray-700', !on);
            btn.classList.toggle('hover:text-gray-900', !on);
          }
          if (content) content.classList.toggle('hidden', !on);
        });
        // Tell tab components they just became visible — the Explorer and
        // Hourly Trends fetch their (heavy) data on first activation.
        document.dispatchEvent(new CustomEvent('clif:tab', { detail: name }));
        // Leaflet needs a resize once its container becomes visible.
        if (name === 'map') {
          setTimeout(() => {
            if (window.L && window.L.map) {
              document.querySelectorAll('#map').forEach((el) => {
                if (el._leaflet_id) (el._leaflet_map || L.map(el)).invalidateSize();
              });
            }
          }, 100);
        }
      }
      TABS.forEach((t) => document.getElementById('tab-' + t)?.addEventListener('click', () => activateTab(t)));

      // The cohort picker lives in another script block and needs to move off a
      // tab that a cohort switch has just hidden.
      window.__activateTab = activateTab;

      // Critically ill modal
      const criticallyIllTrigger = document.getElementById('critically-ill-trigger');
      const criticallyIllModal = document.getElementById('critically-ill-modal');
      const modalBackdrop = document.getElementById('modal-backdrop');
      const modalClose = document.getElementById('modal-close');

      function openModal() {
        criticallyIllModal?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        criticallyIllModal?.classList.add('hidden');
        document.body.style.overflow = '';
      }

      criticallyIllTrigger?.addEventListener('click', openModal);
      // The phrase is styled as a definition link, so it opens the modal too —
      // the marker beside it should not be the only hit target. Listener sits on
      // the span itself, so the bus rewriting its textContent doesn't remove it.
      document.getElementById('hero-cohort-label')?.addEventListener('click', (e) => {
        if (e.currentTarget.classList.contains('cursor-help')) openModal();
      });
      modalBackdrop?.addEventListener('click', closeModal);
      modalClose?.addEventListener('click', closeModal);

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    });
  </script>

  <!-- Cohort Picker wiring -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const Bus = window.CohortBus;
      if (!Bus) return;
      const typeSelect = document.getElementById('cohort-type-select');
      const subWrap = document.getElementById('cohort-sub-wrap');
      const subSelect = document.getElementById('cohort-sub-select');
      const tabHourly = document.getElementById('tab-hourly');
      const tabDistributions = document.getElementById('tab-distributions');
      const SUBS = window.__SUBS_BY_PARENT__ || {};

      function parentOf(key) { return key && key.indexOf('__') > -1 ? key.split('__')[0] : key; }

      // Show/populate the sub-group selector when the active type has ICU/ED
      // splits. Driven purely by the SUBS lookup now that there is no group
      // control — a cohort without splits simply has no entry.
      function paintSubSelect(current) {
        const type = parentOf(current);
        const subs = SUBS[type];
        if (!subs || !subs.length) {
          subWrap?.classList.add('hidden');
          return;
        }
        let html = `<option value="${type}">All</option>`;
        subs.forEach((s) => { html += `<option value="${s.key}">${s.label}</option>`; });
        if (subSelect) { subSelect.innerHTML = html; subSelect.value = current; }
        subWrap?.classList.remove('hidden');
      }

      // Tab gating + selectors react to cohort changes.
      Bus.subscribe((key) => {
        const h = Bus.headline(key);
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        // The hero follows the selection. It used to be fixed to the default
        // cohort, which read as a bug the moment anyone picked Ward-stay: that
        // cohort has 2.3x the patients across fewer sites, so every figure in
        // the sentence contradicted the tiles directly beneath it.
        set('hero-patients', h.patients);
        set('hero-encounters', h.encounters);
        set('hero-hospitals', h.hospitals);
        set('hero-cohort-label', h.noun);

        // Scope note: only cohorts that declare a description show one.
        const note = document.getElementById('hero-cohort-note');
        if (note) {
          note.textContent = h.description || '';
          note.classList.toggle('hidden', !h.description);
        }

        // The modal behind the info icon defines "critically ill" and describes
        // nothing about the ward cohort, so the trigger goes with the wording.
        // The open handler tests for cursor-help, so dropping that class is what
        // disables the click path on the phrase itself.
        const label = document.getElementById('hero-cohort-label');
        const trigger = document.getElementById('critically-ill-trigger');
        if (trigger) trigger.classList.toggle('hidden', !h.isCriticallyIll);
        if (label) {
          ['underline', 'decoration-dotted', 'underline-offset-2', 'cursor-help',
           'text-blue-600', 'hover:text-blue-800'].forEach((c) =>
            label.classList.toggle(c, !!h.isCriticallyIll));
        }

        // The summary subtitle no longer needs a name span: the picker itself
        // sits inline in the sentence and shows the selection.
        // Hourly and Distributions only apply to cohorts that ship that data.
        // The ward cohort has neither — its upstream pipeline emits table_one
        // only — so both tabs disappear rather than opening on an empty state.
        if (tabHourly) tabHourly.classList.toggle('hidden', !h.hasHourly);
        if (tabDistributions) tabDistributions.classList.toggle('hidden', !h.hasDistributions);

        // Hiding the button is not enough: if that tab is the one currently
        // open, its panel stays on screen with no way back to it. Fall back to
        // Summary, which every cohort has.
        const openHidden = [
          [tabHourly, 'hourly'],
          [tabDistributions, 'distributions'],
        ].some(([btn, name]) =>
          btn && btn.classList.contains('hidden') &&
          !document.getElementById('content-' + name)?.classList.contains('hidden')
        );
        if (openHidden && typeof window.__activateTab === 'function') window.__activateTab('summary');

        if (typeSelect) typeSelect.value = parentOf(key);
        paintSubSelect(key);
      });

      // Changing type resets to the "All" subgroup (the base cohort key).
      typeSelect?.addEventListener('change', (e) => Bus.set(e.target.value));
      subSelect?.addEventListener('change', (e) => Bus.set(e.target.value));
    });
  </script>

  <style>
    /* Hide default summary marker in webkit browsers */
    summary::-webkit-details-marker {
      display: none;
    }
  </style>
</BaseLayout>